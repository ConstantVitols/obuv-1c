&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КаталогИмпорта = "C:\DE_Obuv\Resources\import";
	ЖурналИмпорта = "";

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)

	ВыполнитьИмпортНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВыполнитьИмпортНаСервере()

	ЖурналИмпорта = "";
	НовыеФотографии = Новый Массив;
	ТранзакцияОткрыта = Ложь;
	ЭтапИмпорта = "проверка папки и чтение файлов";

	Попытка
		КаталогИмпорта = СокрЛП(КаталогИмпорта);
		ПапкаИсточника = Новый Файл(КаталогИмпорта);
		Если ПустаяСтрока(КаталогИмпорта) Тогда
			ВызватьИсключение "Укажите папку с исходными файлами.";
		КонецЕсли;
		Если Не ПапкаИсточника.Существует() Тогда
			ВызватьИсключение "Папка не найдена: " + КаталогИмпорта;
		КонецЕсли;
		Если Не ПапкаИсточника.ЭтоКаталог() Тогда
			ВызватьИсключение "В поле пути нужно указать папку.";
		КонецЕсли;

		ТаблицаПользователей = ПрочитатьExcel("user_import.xlsx");
		ТаблицаПунктов = ПрочитатьExcel("Пункты выдачи_import.xlsx");
		ТаблицаТоваров = ПрочитатьExcel("Tovar.xlsx");
		ТаблицаЗаказов = ПрочитатьExcel("Заказ_import.xlsx");
		ПроверитьЗаголовки(ТаблицаПользователей,
			"Роль сотрудника;ФИО;Логин;Пароль", "user_import.xlsx");
		ПроверитьЗаголовки(ТаблицаТоваров,
			"Артикул;Наименование товара;Единица измерения;Цена;Поставщик;Производитель;Категория товара;Действующая скидка;Кол-во на складе;Описание товара;Фото",
			"Tovar.xlsx");
		ПроверитьЗаголовки(ТаблицаЗаказов,
			"Номер заказа;Артикул заказа;Дата заказа;Дата доставки;Адрес пункта выдачи;ФИО авторизированного клиента;Код для получения;Статус заказа",
			"Заказ_import.xlsx");
		КаталогБазы = ПолучитьКаталогБазы();
		КаталогФотографий = СоединитьПути(КаталогБазы, "Images");
		ОбеспечитьКаталог(КаталогФотографий);

		НачатьТранзакцию();
		ТранзакцияОткрыта = Истина;
		ЭтапИмпорта = "пользователи";
		ПользователиПоФИО = ЗагрузитьПользователей(ТаблицаПользователей);
		ЭтапИмпорта = "пункты выдачи";
		ПунктыПоНомеру = ЗагрузитьПунктыВыдачи(ТаблицаПунктов);
		ЭтапИмпорта = "товары и связанные справочники";
		ТоварыПоАртикулу = ЗагрузитьТовары(
			ТаблицаТоваров, КаталогФотографий, НовыеФотографии);
		ЭтапИмпорта = "заказы и их состав";
		ЗагрузитьЗаказы(ТаблицаЗаказов,
			ПользователиПоФИО, ПунктыПоНомеру, ТоварыПоАртикулу);
		ЭтапИмпорта = "контроль количества записей";
		Сводка = ПолучитьСводкуПоБазе();
		ЗафиксироватьТранзакцию();
		ТранзакцияОткрыта = Ложь;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если ТранзакцияОткрыта Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Для Каждого ПутьФотографии Из НовыеФотографии Цикл
			Попытка
				УдалитьФайлы(ПутьФотографии);
			Исключение
				ДобавитьВЖурнал("Не удалось убрать новый файл: " + ПутьФотографии);
			КонецПопытки;
		КонецЦикла;
		ДобавитьВЖурнал("ОШИБКА. Этап: " + ЭтапИмпорта);
		ДобавитьВЖурнал(ТекстОшибки);
		ДобавитьВЖурнал("Изменения базы этого запуска не сохранены. "
			+ "Исправьте указанную причину и повторите загрузку.");
		Возврат;
	КонецПопытки;

	ЖурналИмпорта = Сводка + Символы.ПС + "ИМПОРТ ЗАВЕРШЁН";

КонецПроцедуры

&НаСервере
Функция ПрочитатьExcel(ИмяФайла)

	ПутьФайла = СоединитьПути(КаталогИмпорта, ИмяФайла);
	ФайлИсточника = Новый Файл(ПутьФайла);
	Если Не ФайлИсточника.Существует() Тогда
		ВызватьИсключение "Не найден файл: " + ПутьФайла;
	КонецЕсли;
	ТаблицаФайла = Новый ТабличныйДокумент;
	ТаблицаФайла.Прочитать(ПутьФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Возврат ТаблицаФайла;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, НомерКолонки)

	Ячейка = ТаблицаФайла.Область(НомерСтроки, НомерКолонки);
	Если Ячейка.СодержитЗначение Тогда
		Возврат Ячейка.Значение;
	КонецЕсли;
	Возврат Ячейка.Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстЯчейки(ТаблицаФайла, НомерСтроки, НомерКолонки)

	Возврат СокрЛП(Строка(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, НомерКолонки)));

КонецФункции

&НаСервереБезКонтекста
Функция ПустаяСтрокаТаблицы(ТаблицаФайла, НомерСтроки, ЧислоКолонок)

	Для НомерКолонки = 1 По ЧислоКолонок Цикл
		Если Не ПустаяСтрока(ТекстЯчейки(ТаблицаФайла, НомерСтроки, НомерКолонки)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьЗаголовки(ТаблицаФайла, ОжидаемыеЗаголовки, ИмяФайла)

	Заголовки = СтрРазделить(ОжидаемыеЗаголовки, ";", Истина);
	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
		Если НРег(ТекстЯчейки(ТаблицаФайла, 1, Индекс + 1)) <> НРег(Заголовки[Индекс]) Тогда
			ВызватьИсключение ИмяФайла + ": в столбце " + Строка(Индекс + 1)
				+ " ожидается заголовок «" + Заголовки[Индекс] + "».";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьТекст(Значение, МаксимальнаяДлина, ОписаниеПоля, Обязательное = Истина)

	ТекстЗначения = СокрЛП(Строка(Значение));
	Если Обязательное И ПустаяСтрока(ТекстЗначения) Тогда
		ВызватьИсключение "Не заполнено поле: " + ОписаниеПоля;
	КонецЕсли;
	Если СтрДлина(ТекстЗначения) > МаксимальнаяДлина Тогда
		ВызватьИсключение "Слишком длинное значение: " + ОписаниеПоля
			+ ". Максимум символов: " + Строка(МаксимальнаяДлина);
	КонецЕсли;
	Возврат ТекстЗначения;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЧисло(Значение, ОписаниеПоля, ЦелоеЧисло = Ложь)

	Если ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
		ВызватьИсключение "Не заполнено числовое поле: " + ОписаниеПоля;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Результат = Значение;
		Иначе
			ТекстЧисла = СтрЗаменить(СокрЛП(Строка(Значение)), " ", "");
			ТекстЧисла = СтрЗаменить(ТекстЧисла, Символ(160), "");
			Результат = Число(СтрЗаменить(ТекстЧисла, ",", "."));
		КонецЕсли;
	Исключение
		ВызватьИсключение "Ожидается число: " + ОписаниеПоля;
	КонецПопытки;
	Если Результат < 0 Тогда
		ВызватьИсключение "Отрицательное значение: " + ОписаниеПоля;
	КонецЕсли;
	Если ЦелоеЧисло И Результат <> Цел(Результат) Тогда
		ВызватьИсключение "Ожидается целое число: " + ОписаниеПоля;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДату(Значение, ОписаниеПоля)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат НачалоДня(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат НачалоДня(Дата(1899, 12, 30) + Значение * 86400);
	КонецЕсли;
	Попытка
		Части = СтрРазделить(СокрЛП(Строка(Значение)), ".-/", Истина);
		Если Части.Количество() <> 3 Тогда
			ВызватьИсключение "Ожидается дата в формате ДД.ММ.ГГГГ.";
		КонецЕсли;
		Если СтрДлина(Части[0]) = 4 Тогда
			ГодДаты = Число(Части[0]);
			МесяцДаты = Число(Части[1]);
			ДеньДаты = Число(Части[2]);
		Иначе
			ДеньДаты = Число(Части[0]);
			МесяцДаты = Число(Части[1]);
			ГодДаты = Число(Части[2]);
		КонецЕсли;
		Если ГодДаты < 100 Тогда
			ГодДаты = 2000 + ГодДаты;
		КонецЕсли;
		Результат = Дата(ГодДаты, МесяцДаты, ДеньДаты);
		Если Год(Результат) <> ГодДаты Или Месяц(Результат) <> МесяцДаты
			Или День(Результат) <> ДеньДаты Тогда
			ВызватьИсключение "Несуществующая календарная дата.";
		КонецЕсли;
	Исключение
		ВызватьИсключение "Некорректная дата: " + ОписаниеПоля + " = " + Строка(Значение);
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоЗначению(ИмяТаблицы, ИмяРеквизита, ИскомоеЗначение)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Данные.Ссылка КАК Ссылка ИЗ "
		+ ИмяТаблицы + " КАК Данные ГДЕ Данные." + ИмяРеквизита + " = &Значение";
	Запрос.УстановитьПараметр("Значение", ИскомоеЗначение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Найдены дубли: " + ИмяТаблицы + ", "
			+ ИмяРеквизита + " = " + Строка(ИскомоеЗначение);
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЭлементПоИмени(ИмяСправочника, Наименование)

	Ссылка = НайтиПоЗначению("Справочник." + ИмяСправочника, "Наименование", Наименование);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

&НаСервере
Функция ЗагрузитьПользователей(ТаблицаФайла)

	КартаПоФИО = Новый Соответствие;
	ЛогиныИсточника = Новый Соответствие;
	Создано = 0;
	ЧислоСтрок = 0;
	Для НомерСтроки = 2 По ТаблицаФайла.ВысотаТаблицы Цикл
		Если ПустаяСтрокаТаблицы(ТаблицаФайла, НомерСтроки, 4) Тогда
			Продолжить;
		КонецЕсли;
		КонтекстСтроки = ", строка " + Строка(НомерСтроки);
		ФИО = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 2), 150, "ФИО" + КонтекстСтроки);
		Логин = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 3), 254, "логин" + КонтекстСтроки);
		РольТекст = НРег(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 1));
		Если РольТекст = "администратор" Тогда
			РольПользователя = Перечисления.РолиПользователей.Администратор;
		ИначеЕсли РольТекст = "менеджер" Тогда
			РольПользователя = Перечисления.РолиПользователей.Менеджер;
		ИначеЕсли РольТекст = "авторизированный клиент" Или РольТекст = "авторизованный клиент"
			Или РольТекст = "клиент" Тогда
			РольПользователя = Перечисления.РолиПользователей.Клиент;
		Иначе
			ВызватьИсключение "Неизвестная роль пользователя" + КонтекстСтроки;
		КонецЕсли;
		Если ЛогиныИсточника.Получить(НРег(Логин)) <> Неопределено Тогда
			ВызватьИсключение "Повторяющийся логин" + КонтекстСтроки;
		КонецЕсли;
		ЛогиныИсточника.Вставить(НРег(Логин), Истина);
		Пароль = Строка(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 4));
		Если ПустаяСтрока(Пароль) Тогда
			ВызватьИсключение "Не заполнен пароль" + КонтекстСтроки;
		КонецЕсли;
		Ссылка = НайтиПоЗначению("Справочник.Пользователи", "Логин", Логин);
		Если Ссылка = Неопределено Тогда
			Пользователь = Справочники.Пользователи.СоздатьЭлемент();
			Пользователь.Наименование = ФИО;
			Пользователь.Логин = Логин;
			Пользователь.Роль = РольПользователя;
			Пользователь.СольПароля = РаботаСПаролями.СоздатьСольПароля();
			Пользователь.ХешПароля = РаботаСПаролями.СформироватьХешПароля(Пароль, Пользователь.СольПароля);
			Пользователь.Записать();
			Ссылка = Пользователь.Ссылка;
			Создано = Создано + 1;
		КонецЕсли;
		Кандидаты = КартаПоФИО.Получить(ФИО);
		Если Кандидаты = Неопределено Тогда
			Кандидаты = Новый Массив;
			КартаПоФИО.Вставить(ФИО, Кандидаты);
		КонецЕсли;
		Кандидаты.Добавить(Ссылка);
		ЧислоСтрок = ЧислоСтрок + 1;
	КонецЦикла;
	Если КартаПоФИО.Количество() = 0 Тогда
		ВызватьИсключение "В user_import.xlsx отсутствуют строки пользователей.";
	КонецЕсли;
	ДобавитьВЖурнал("Пользователи: строк " + Строка(ЧислоСтрок) + ", новых " + Строка(Создано));
	Возврат КартаПоФИО;

КонецФункции

&НаСервере
Функция ЗагрузитьПунктыВыдачи(ТаблицаФайла)

	КартаПунктов = Новый Соответствие;
	Создано = 0;
	Для НомерСтроки = 1 По ТаблицаФайла.ВысотаТаблицы Цикл
		Если ПустаяСтрокаТаблицы(ТаблицаФайла, НомерСтроки, 1) Тогда
			Продолжить;
		КонецЕсли;
		Адрес = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 1), 150, "адрес пункта выдачи");
		Ссылка = Справочники.ПунктыВыдачи.НайтиПоКоду(НомерСтроки);
		Если Ссылка.Пустая() Тогда
			Пункт = Справочники.ПунктыВыдачи.СоздатьЭлемент();
			Пункт.Код = НомерСтроки;
			Пункт.Наименование = Адрес;
			Пункт.Записать();
			Ссылка = Пункт.Ссылка;
			Создано = Создано + 1;
		ИначеЕсли Ссылка.Наименование <> Адрес Тогда
			ВызватьИсключение "Код пункта выдачи " + Строка(НомерСтроки)
				+ " уже занят другим адресом. Проверьте данные перед повторной загрузкой.";
		КонецЕсли;
		КартаПунктов.Вставить(НомерСтроки, Ссылка);
	КонецЦикла;
	Если КартаПунктов.Количество() = 0 Тогда
		ВызватьИсключение "В файле пунктов выдачи отсутствуют адреса.";
	КонецЕсли;
	ДобавитьВЖурнал("Пункты выдачи: строк " + Строка(КартаПунктов.Количество()) + ", новых " + Строка(Создано));
	Возврат КартаПунктов;

КонецФункции

&НаСервере
Функция ЗагрузитьТовары(ТаблицаФайла, КаталогФотографий, НовыеФотографии)

	КартаТоваров = Новый Соответствие;
	Создано = 0;
	Для НомерСтроки = 2 По ТаблицаФайла.ВысотаТаблицы Цикл
		Если ПустаяСтрокаТаблицы(ТаблицаФайла, НомерСтроки, 11) Тогда
			Продолжить;
		КонецЕсли;
		КонтекстСтроки = ", строка " + Строка(НомерСтроки);
		Артикул = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 1), 50, "артикул" + КонтекстСтроки);
		Если КартаТоваров.Получить(Артикул) <> Неопределено Тогда
			ВызватьИсключение "Повторяющийся артикул " + Артикул + КонтекстСтроки;
		КонецЕсли;
		Название = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 2), 150, "название товара" + КонтекстСтроки);
		Единица = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 3), 100, "единица измерения" + КонтекстСтроки);
		ЦенаТовара = ПроверитьЧисло(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 4), "цена" + КонтекстСтроки);
		Поставщик = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 5), 100, "поставщик" + КонтекстСтроки);
		Производитель = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 6), 100, "производитель" + КонтекстСтроки);
		Категория = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 7), 100, "категория" + КонтекстСтроки);
		СкидкаТовара = ПроверитьЧисло(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 8), "скидка" + КонтекстСтроки);
		ОстатокТовара = ПроверитьЧисло(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 9), "количество на складе" + КонтекстСтроки, Истина);
		ОписаниеТовара = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 10), 1000, "описание" + КонтекстСтроки, Ложь);
		Фото = ТекстЯчейки(ТаблицаФайла, НомерСтроки, 11);
		Если СкидкаТовара > 100 Тогда
			ВызватьИсключение "Скидка должна быть от 0 до 100 процентов" + КонтекстСтроки;
		КонецЕсли;
		Если ЦенаТовара > 9999999999999.99 Или Окр(ЦенаТовара, 2) <> ЦенаТовара
			Или ОстатокТовара > 9999999999 Или Окр(СкидкаТовара, 2) <> СкидкаТовара Тогда
			ВызватьИсключение "Числовое значение не помещается в поле товара" + КонтекстСтроки;
		КонецЕсли;
		КатегорияСсылка = ПолучитьЭлементПоИмени("КатегорииТоваров", Категория);
		ПроизводительСсылка = ПолучитьЭлементПоИмени("Производители", Производитель);
		ПоставщикСсылка = ПолучитьЭлементПоИмени("Поставщики", Поставщик);
		ЕдиницаСсылка = ПолучитьЭлементПоИмени("ЕдиницыИзмерения", Единица);
		Ссылка = НайтиПоЗначению("Справочник.Товары", "Артикул", Артикул);
		Если Ссылка = Неопределено Тогда
			Товар = Справочники.Товары.СоздатьЭлемент();
			Товар.Наименование = Название;
			Товар.Артикул = Артикул;
			Товар.Категория = КатегорияСсылка;
			Товар.Производитель = ПроизводительСсылка;
			Товар.Поставщик = ПоставщикСсылка;
			Товар.ЕдиницаИзмерения = ЕдиницаСсылка;
			Товар.Цена = ЦенаТовара;
			Товар.КоличествоНаСкладе = ОстатокТовара;
			Товар.Скидка = СкидкаТовара;
			Товар.Описание = ОписаниеТовара;
			Если Не ПустаяСтрока(Фото) Тогда
				ФайлФото = Новый Файл(Фото);
				Если ФайлФото.Имя <> Фото Тогда
					ВызватьИсключение "В столбце «Фото» ожидается имя файла" + КонтекстСтроки;
				КонецЕсли;
				ИсточникФото = СоединитьПути(КаталогИмпорта, Фото);
				ПриемникФото = СоединитьПути(КаталогФотографий, Фото);
				ФайлИсточника = Новый Файл(ИсточникФото);
				Если Не ФайлИсточника.Существует() Тогда
					ВызватьИсключение "Не найдена фотография: " + ИсточникФото;
				КонецЕсли;
				ФайлПриемника = Новый Файл(ПриемникФото);
				Если Не ФайлПриемника.Существует() Тогда
					НовыеФотографии.Добавить(ПриемникФото);
					КопироватьФайл(ИсточникФото, ПриемникФото);
				КонецЕсли;
				Товар.ПутьКИзображению = "Images\" + Фото;
			КонецЕсли;
			Товар.Записать();
			Ссылка = Товар.Ссылка;
			Создано = Создано + 1;
		КонецЕсли;
		КартаТоваров.Вставить(Артикул, Ссылка);
	КонецЦикла;
	Если КартаТоваров.Количество() = 0 Тогда
		ВызватьИсключение "В Tovar.xlsx отсутствуют строки товаров.";
	КонецЕсли;
	ДобавитьВЖурнал("Товары: строк " + Строка(КартаТоваров.Количество()) + ", новых " + Строка(Создано));
	Возврат КартаТоваров;

КонецФункции

&НаСервере
Процедура ЗагрузитьЗаказы(ТаблицаФайла, ПользователиПоФИО, ПунктыПоНомеру, ТоварыПоАртикулу)

	НомераИсточника = Новый Соответствие;
	Создано = 0;
	ЧислоПозиций = 0;
	Для НомерСтроки = 2 По ТаблицаФайла.ВысотаТаблицы Цикл
		Если ПустаяСтрокаТаблицы(ТаблицаФайла, НомерСтроки, 8) Тогда
			Продолжить;
		КонецЕсли;
		КонтекстСтроки = ", строка " + Строка(НомерСтроки);
		НомерЗаказа = ПроверитьЧисло(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 1), "номер заказа" + КонтекстСтроки, Истина);
		Если НомерЗаказа = 0 Или НомерЗаказа > 999999999 Тогда
			ВызватьИсключение "Номер заказа должен быть от 1 до 999999999" + КонтекстСтроки;
		КонецЕсли;
		Если НомераИсточника.Получить(НомерЗаказа) <> Неопределено Тогда
			ВызватьИсключение "В исходном файле повторяется номер заказа " + Строка(НомерЗаказа);
		КонецЕсли;
		НомераИсточника.Вставить(НомерЗаказа, Истина);
		ИсходнаяДата = ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 3);
		Если НомерЗаказа = 7 И СокрЛП(Строка(ИсходнаяДата)) = "30.02.2025" Тогда
			ДатаЗаказа = Дата(2025, 2, 28);
			ДобавитьВЖурнал("Корректировка исходника: заказ №7, C8, 30.02.2025 → 28.02.2025.");
		Иначе
			ДатаЗаказа = ПроверитьДату(ИсходнаяДата, "дата заказа" + КонтекстСтроки);
		КонецЕсли;
		ДатаДоставки = ПроверитьДату(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 4), "дата доставки" + КонтекстСтроки);
		Если ДатаДоставки < ДатаЗаказа Тогда
			ВызватьИсключение "Дата доставки раньше даты заказа" + КонтекстСтроки;
		КонецЕсли;
		НомерПункта = ПроверитьЧисло(ЗначениеЯчейки(ТаблицаФайла, НомерСтроки, 5), "номер пункта" + КонтекстСтроки, Истина);
		ПунктСсылка = ПунктыПоНомеру.Получить(НомерПункта);
		ФИО = ТекстЯчейки(ТаблицаФайла, НомерСтроки, 6);
		КлиентСсылка = ОпределитьКлиентаЗаказа(ПользователиПоФИО.Получить(ФИО), ФИО, НомерЗаказа);
		Если ПунктСсылка = Неопределено Тогда
			ВызватьИсключение "Не найден пункт выдачи" + КонтекстСтроки;
		КонецЕсли;
		КодПолучения = ПроверитьТекст(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 7), 20, "код получения" + КонтекстСтроки);
		СтатусТекст = НРег(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 8));
		Если СтатусТекст = "новый" Тогда
			СтатусЗаказа = Перечисления.СтатусыЗаказов.Новый;
		ИначеЕсли СтатусТекст = "завершен" Или СтатусТекст = "завершён" Тогда
			СтатусЗаказа = Перечисления.СтатусыЗаказов.Завершен;
		Иначе
			ВызватьИсключение "Неизвестный статус заказа" + КонтекстСтроки;
		КонецЕсли;

		ЧастиСостава = СтрРазделить(ТекстЯчейки(ТаблицаФайла, НомерСтроки, 2), ",", Истина);
		Если ЧастиСостава.Количество() < 2
			Или Цел(ЧастиСостава.Количество() / 2) * 2 <> ЧастиСостава.Количество() Тогда
			ВызватьИсключение "Состав заказа должен содержать пары «артикул, количество»" + КонтекстСтроки;
		КонецЕсли;
		Позиции = Новый Массив;
		Индекс = 0;
		Пока Индекс < ЧастиСостава.Количество() Цикл
			Артикул = СокрЛП(ЧастиСостава[Индекс]);
			ТоварСсылка = ТоварыПоАртикулу.Получить(Артикул);
			Если ТоварСсылка = Неопределено Тогда
				ВызватьИсключение "Не найден товар «" + Артикул + "»" + КонтекстСтроки;
			КонецЕсли;
			КоличествоТовара = ПроверитьЧисло(ЧастиСостава[Индекс + 1], "количество в заказе" + КонтекстСтроки, Истина);
			Если КоличествоТовара = 0 Или КоличествоТовара > 9999999999 Тогда
				ВызватьИсключение "Недопустимое количество в заказе" + КонтекстСтроки;
			КонецЕсли;
			Позиции.Добавить(Новый Структура("Товар,Количество", ТоварСсылка, КоличествоТовара));
			Индекс = Индекс + 2;
		КонецЦикла;
		ЧислоПозиций = ЧислоПозиций + Позиции.Количество();
		СсылкаЗаказа = Документы.Заказ.НайтиПоНомеру(НомерЗаказа);
		Если СсылкаЗаказа.Пустая() Тогда
			Заказ = Документы.Заказ.СоздатьДокумент();
			Заказ.Номер = НомерЗаказа;
			Заказ.Дата = ДатаЗаказа;
			Заказ.Клиент = КлиентСсылка;
			Заказ.ПунктВыдачи = ПунктСсылка;
			Заказ.Статус = СтатусЗаказа;
			Заказ.ДатаДоставки = ДатаДоставки;
			Заказ.КодПолучения = КодПолучения;
			Для Каждого Позиция Из Позиции Цикл
				СтрокаЗаказа = Заказ.Товары.Добавить();
				СтрокаЗаказа.Товар = Позиция.Товар;
				СтрокаЗаказа.Количество = Позиция.Количество;
			КонецЦикла;
			Заказ.Записать(РежимЗаписиДокумента.Запись);
			Создано = Создано + 1;
		КонецЕсли;
	КонецЦикла;
	Если НомераИсточника.Количество() = 0 Тогда
		ВызватьИсключение "В Заказ_import.xlsx отсутствуют строки заказов.";
	КонецЕсли;
	ДобавитьВЖурнал("Заказы: строк " + Строка(НомераИсточника.Количество())
		+ ", новых " + Строка(Создано) + ", позиций в источнике " + Строка(ЧислоПозиций));

КонецПроцедуры

&НаСервере
Функция ОпределитьКлиентаЗаказа(Кандидаты, ФИО, НомерЗаказа)

	Если Кандидаты = Неопределено Тогда
		ВызватьИсключение "Для заказа №" + Строка(НомерЗаказа) + " не найден пользователь: " + ФИО;
	КонецЕсли;
	Если Кандидаты.Количество() <> 1 Тогда
		ВызватьИсключение "Для заказа №" + Строка(НомерЗаказа)
			+ " найдено несколько учётных записей с ФИО «" + ФИО
			+ "». Уточните, с какой учётной записью связать заказ.";
	КонецЕсли;
	Возврат Кандидаты[0];

КонецФункции

&НаСервереБезКонтекста
Функция СоединитьПути(Каталог, ИмяФайла)

	Если Прав(Каталог, 1) = "\" Или Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог + ИмяФайла;
	КонецЕсли;
	Возврат Каталог + "\" + ИмяФайла;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКаталогБазы()

	Соединение = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=""";
	Позиция = СтрНайти(Соединение, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "Эта обработка подготовлена для файловой информационной базы.";
	КонецЕсли;
	Остаток = Сред(Соединение, Позиция + СтрДлина(Маркер));
	КонецПути = СтрНайти(Остаток, """");
	Если КонецПути = 0 Тогда
		ВызватьИсключение "Не удалось определить папку информационной базы.";
	КонецЕсли;
	Возврат Лев(Остаток, КонецПути - 1);

КонецФункции

&НаСервереБезКонтекста
Процедура ОбеспечитьКаталог(ПутьКаталога)

	Каталог = Новый Файл(ПутьКаталога);
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(ПутьКаталога);
	ИначеЕсли Не Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Вместо папки найден файл: " + ПутьКаталога;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоЗаписей(ИмяТаблицы)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоЗаписей ИЗ " + ИмяТаблицы);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ЧислоЗаписей;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСводкуПоБазе()

	Сводка = "Загружено в базу (всего записей):";
	Таблицы = Новый Структура;
	Таблицы.Вставить("Пользователи", "Справочник.Пользователи");
	Таблицы.Вставить("ПунктыВыдачи", "Справочник.ПунктыВыдачи");
	Таблицы.Вставить("Товары", "Справочник.Товары");
	Таблицы.Вставить("Заказы", "Документ.Заказ");
	Таблицы.Вставить("ПозицииЗаказов", "Документ.Заказ.Товары");
	Таблицы.Вставить("КатегорииТоваров", "Справочник.КатегорииТоваров");
	Таблицы.Вставить("Производители", "Справочник.Производители");
	Таблицы.Вставить("Поставщики", "Справочник.Поставщики");
	Таблицы.Вставить("ЕдиницыИзмерения", "Справочник.ЕдиницыИзмерения");
	Для Каждого Таблица Из Таблицы Цикл
		Сводка = Сводка + Символы.ПС + Таблица.Ключ + ": "
			+ Строка(КоличествоЗаписей(Таблица.Значение));
	КонецЦикла;
	Возврат Сводка;

КонецФункции

&НаСервере
Процедура ДобавитьВЖурнал(ТекстСообщения)

	ЖурналИмпорта = ЖурналИмпорта + Символы.ПС + ТекстСообщения;

КонецПроцедуры