&НаКлиенте
Перем РазрешеноЗакрытие;

// Текст поиска, для которого последний раз успешно получен HTML
&НаКлиенте
Перем ПоследнийТекстПоиска;

// Отбор по поставщику последней успешной загрузки
&НаКлиенте
Перем ПоследнийПоставщик;

// Направление сортировки последней успешной загрузки
&НаКлиенте
Перем ПоследняяСортировка;

// Разрешает сравнивать фильтры с предыдущим успешным запросом
&НаКлиенте
Перем ЕстьУспешнаяЗагрузка;

// Предотвращает одновременное открытие нескольких редакторов товара
&НаКлиенте
Перем ФормаТовараОткрыта;

// Предотвращает повторное открытие уже открытого списка заказов
&НаКлиенте
Перем ФормаСпискаЗаказовОткрыта;

// Не допускает открытие витрины до входа, устанавливает ФИО, заголовок и начальные фильтры
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Доступ = АвторизацияСервер.ПолучитьТекущийДоступ();
	Если Не Доступ.ВходВыполнен Тогда
		Отказ = Истина;
		Сообщить("Сначала выполните вход в систему.");
		Возврат;
	КонецЕсли;

	ФИОПользователя = Доступ.ФИО;
	Заголовок = "Каталог обуви -" + Доступ.Роль;
	ПоисковаяСтрока = "";
	ПоставщикОтбор = Справочники.Поставщики.ПустаяСсылка();
	СортировкаОстатков = "Без сортировки";
	Элементы.ПанельОтбора.Видимость = Доступ.МожетИскать;
	НастроитьКнопкуДобавления(Доступ.МожетИзменятьДанные);
	НастроитьКнопкуЗаказов(Доступ.МожетПросматриватьЗаказы);

	Элементы.ПоставщикОтбор.РежимВыбораИзСписка = Истина;
	Элементы.ПоставщикОтбор.СписокВыбора.Очистить();
	Элементы.ПоставщикОтбор.СписокВыбора.Добавить(
		Справочники.Поставщики.ПустаяСсылка(), "Все поставщики");
	Если Доступ.МожетИскать Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Поставщики.Ссылка КАК Ссылка, "
			+ "Поставщики.Наименование КАК Наименование "
			+ "ИЗ Справочник.Поставщики КАК Поставщики "
			+ "ГДЕ НЕ Поставщики.ПометкаУдаления "
			+ "УПОРЯДОЧИТЬ ПО Поставщики.Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Элементы.ПоставщикОтбор.СписокВыбора.Добавить(
				Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;

	Элементы.СортировкаОстатков.РежимВыбораИзСписка = Истина;
	Элементы.СортировкаОстатков.СписокВыбора.Очистить();
	Элементы.СортировкаОстатков.СписокВыбора.Добавить("Без сортировки");
	Элементы.СортировкаОстатков.СписокВыбора.Добавить("По возрастанию");
	Элементы.СортировкаОстатков.СписокВыбора.Добавить("По убыванию");

КонецПроцедуры

// Находит или создаёт команду и кнопку добавления, связывает их с обработчиком и устанавливает
// видимость для администратора
&НаСервере
Процедура НастроитьКнопкуДобавления(РазрешеноДобавление)

	КомандаДобавления = Команды.Найти("ДобавитьТовар");
	Если КомандаДобавления = Неопределено Тогда
		КомандаДобавления = Команды.Добавить("ДобавитьТовар");
	КонецЕсли;
	КомандаДобавления.Заголовок = "Добавить товар";
	КомандаДобавления.Действие = "ДобавитьТовар";

	КнопкаДобавления = Элементы.Найти("ДобавитьТовар");
	Если КнопкаДобавления = Неопределено Тогда
		РодительКнопки = Элементы.Найти("Шапка");
		Если РодительКнопки = Неопределено Тогда
			РодительКнопки = ЭтотОбъект;
		КонецЕсли;
		КнопкаДобавления = Элементы.Добавить(
			"ДобавитьТовар", Тип("КнопкаФормы"), РодительКнопки);
		КнопкаДобавления.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КонецЕсли;
	КнопкаДобавления.ИмяКоманды = "ДобавитьТовар";
	КнопкаДобавления.Видимость = РазрешеноДобавление;
	КнопкаДобавления.Шрифт = Новый Шрифт("Times New Roman", 12);
	КнопкаДобавления.ЦветФона = Новый Цвет(0, 250, 154);
	КнопкаДобавления.ЦветТекста = Новый Цвет(0, 0, 0);

КонецПроцедуры

// Выполняет первую принудительную загрузку HTML
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьКаталог(ПоисковаяСтрока, Истина);

КонецПроцедуры

// Перед обновлением сохраняет текущий редактируемый текст в реквизит ПоисковаяСтрока
&НаКлиенте
Процедура ПоисковаяСтрокаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	// В событии редактирования параметр Текст уже содержит новые символы, а реквизит формы ещё может содержать прежнее значение
	ПоисковаяСтрока = Текст;
	ОбновитьКаталог(ПоисковаяСтрока);

КонецПроцедуры

// Обновляет витрину после фиксации значения поиска
&НаКлиенте
Процедура ПоисковаяСтрокаПриИзменении(Элемент)

	ОбновитьКаталог(ПоисковаяСтрока);

КонецПроцедуры

// Применяет выбранного поставщика совместно с текущими поиском и сортировкой
&НаКлиенте
Процедура ПоставщикОтборПриИзменении(Элемент)

	ОбновитьКаталог(ПоисковаяСтрока);

КонецПроцедуры

// Перестраивает каталог с новым направлением сортировки, сохраняя текст поиска и отбор по поставщику
&НаКлиенте
Процедура СортировкаОстатковПриИзменении(Элемент)

	ОбновитьКаталог(ПоисковаяСтрока);

КонецПроцедуры

// Запрашивает HTML, если фильтры изменились или установлен флаг Принудительно
&НаКлиенте
Процедура ОбновитьКаталог(ТекстПоиска, Принудительно = Ложь)

	// Одинаковый набор фильтров пропускаем только после успешной загрузки
	Если Не Принудительно И ЕстьУспешнаяЗагрузка = Истина Тогда
		Если ТекстПоиска = ПоследнийТекстПоиска
			И ПоставщикОтбор = ПоследнийПоставщик
			И СортировкаОстатков = ПоследняяСортировка Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Разметка = ПолучитьТоварыНаСервере(
			ТекстПоиска, ПоставщикОтбор, СортировкаОстатков);
		// Имя реквизита историческое: здесь хранится полный текст HTML-документа, связанного с ПолеТоваров
		АдресТоваров = Разметка;
	Исключение
		ЕстьУспешнаяЗагрузка = Ложь;
		Сообщить("Не удалось обновить каталог: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ПоследнийТекстПоиска = ТекстПоиска;
	ПоследнийПоставщик = ПоставщикОтбор;
	ПоследняяСортировка = СортировкаОстатков;
	ЕстьУспешнаяЗагрузка = Истина;

КонецПроцедуры

// Передаёт три параметра фильтрации общему модулю КаталогТоваровСервер
&НаСервереБезКонтекста
Функция ПолучитьТоварыНаСервере(ТекстПоиска, Поставщик, Сортировка)

	Возврат КаталогТоваровСервер.СформироватьHTMLТоваров(
		ТекстПоиска, Поставщик, Сортировка);

КонецФункции

// Сначала сбрасывает прикладной вход на сервере, затем закрывает витрину с результатом "ОткрытьВход"
&НаКлиенте
Процедура Выйти(Команда)

	Попытка
		ЗавершитьВходНаСервере();
	Исключение
		Сообщить("Не удалось завершить вход: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	РазрешеноЗакрытие = Истина;
	Закрыть("ОткрытьВход");

КонецПроцедуры

// Разрешает закрытие витрины при подготовленном выходе либо завершении приложения
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не ЗавершениеРаботы И РазрешеноЗакрытие <> Истина Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Очищает параметры авторизации текущего сеанса
&НаСервереБезКонтекста
Процедура ЗавершитьВходНаСервере()

	АвторизацияСервер.СброситьВход();

КонецПроцедуры

// Открывает редактор без ссылки на существующий товар
&НаКлиенте
Процедура ДобавитьТовар(Команда)

	ОткрытьКарточкуТовара(Неопределено);

КонецПроцедуры

// Перехватывает только служебные ссылки obuv-product:UUID и отменяет обычный переход HTML-поля
&НаКлиенте
Процедура ПолеТоваровПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	АдресСсылки = Неопределено;
	Если Не ДанныеСобытия.Свойство("Href", АдресСсылки) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(АдресСсылки) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Префикс = "obuv-product:";
	Если Лев(АдресСсылки, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Попытка
		Идентификатор = Сред(АдресСсылки, СтрДлина(Префикс) + 1);
		СсылкаТовара = НайтиТоварДляРедактированияНаСервере(Идентификатор);
		ОткрытьКарточкуТовара(СсылкаТовара);
	Исключение
		Сообщить("Не удалось открыть карточку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Повторно проверяет право изменения и открывает один редактор с блокировкой витрины
&НаКлиенте
Процедура ОткрытьКарточкуТовара(СсылкаТовара)

	Если ФормаТовараОткрыта = Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПроверитьПравоРедактированияНаСервере();
		ПараметрыФормы = Новый Структура;
		Если СсылкаТовара <> Неопределено Тогда
			ПараметрыФормы.Вставить("Ключ", СсылкаТовара);
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияКарточкиТовара", ЭтотОбъект);
		// Флаг устанавливаем до открытия, чтобы повторный щелчок не создал второй редактор
		ФормаТовараОткрыта = Истина;
		ОткрытьФорму("Справочник.Товары.Форма.ФормаЭлемента", ПараметрыФормы,
			ЭтотОбъект, Истина, , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ФормаТовараОткрыта = Ложь;
		Сообщить("Не удалось открыть карточку товара: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Снимает флаг открытого редактора и принудительно перечитывает каталог с сохранёнными фильтрами
&НаКлиенте
Процедура ПослеЗакрытияКарточкиТовара(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ФормаТовараОткрыта = Ложь;
	ОбновитьКаталог(ПоисковаяСтрока, Истина);

КонецПроцедуры

// Реагирует на сообщение "ТоварыИзменены" после записи карточки
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ТоварыИзменены" Тогда
		ОбновитьКаталог(ПоисковаяСтрока, Истина);
	КонецЕсли;

КонецПроцедуры

// Вызывает общую проверку прав на изменение товаров
&НаСервереБезКонтекста
Процедура ПроверитьПравоРедактированияНаСервере()

	ТоварыСервер.ПроверитьПравоИзменения();

КонецПроцедуры

// Возвращает ссылку по UUID после проверки прав, существования товара и отсутствия пометки удаления
&НаСервереБезКонтекста
Функция НайтиТоварДляРедактированияНаСервере(Идентификатор)

	Возврат ТоварыСервер.НайтиТоварДляРедактирования(Идентификатор);

КонецФункции

// Создаёт при необходимости команду и кнопку перехода к заказам
&НаСервере
Процедура НастроитьКнопкуЗаказов(Показывать)

	КомандаЗаказов = Команды.Найти("Заказы");
	Если КомандаЗаказов = Неопределено Тогда
		КомандаЗаказов = Команды.Добавить("Заказы");
	КонецЕсли;
	КомандаЗаказов.Действие = "Заказы";
	КомандаЗаказов.Заголовок = "Заказы";
	КнопкаЗаказов = Элементы.Найти("Заказы");
	Если КнопкаЗаказов = Неопределено Тогда
		РодительКнопки = Элементы.Найти("Шапка");
		Если РодительКнопки = Неопределено Тогда
			РодительКнопки = ЭтотОбъект;
		КонецЕсли;
		КнопкаЗаказов = Элементы.Добавить("Заказы", Тип("КнопкаФормы"), РодительКнопки);
		КнопкаЗаказов.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КонецЕсли;
	КнопкаЗаказов.ИмяКоманды = "Заказы";
	КнопкаЗаказов.Видимость = Показывать;
	КнопкаЗаказов.Шрифт = Новый Шрифт("Times New Roman", 12);
	КнопкаЗаказов.ЦветФона = Новый Цвет(0, 250, 154);
	КнопкаЗаказов.ЦветТекста = Новый Цвет(0, 0, 0);

КонецПроцедуры

// После серверной проверки открывает один список заказов с блокировкой витрины
&НаКлиенте
Процедура Заказы(Команда)

	Если ФормаТовараОткрыта = Истина Или ФормаСпискаЗаказовОткрыта = Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПроверитьДоступКЗаказамНаСервере();
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСпискаЗаказов", ЭтотОбъект);
		ФормаСпискаЗаказовОткрыта = Истина;
		ОткрытьФорму("Обработка.ПросмотрЗаказов.Форма.Форма", Неопределено,
			ЭтотОбъект, Истина, , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ФормаСпискаЗаказовОткрыта = Ложь;
		ПоказатьПредупреждение(Неопределено, "Не удалось открыть список заказов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Снимает флаг открытого списка и вновь разрешает переход к заказам
&НаКлиенте
Процедура ПослеЗакрытияСпискаЗаказов(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ФормаСпискаЗаказовОткрыта = Ложь;

КонецПроцедуры

// Проверяет право просмотра заказов через общий серверный модуль
&НаСервереБезКонтекста
Процедура ПроверитьДоступКЗаказамНаСервере()

	Доступ = ЗаказыСервер.ПроверитьПравоПросмотра();

КонецПроцедуры