&НаКлиенте
Перем РазрешеноЗакрытие;

// Проверяет заполнение логина и пароля, вызывает серверную авторизацию и обрабатывает отказ
&НаКлиенте
Процедура Войти(Команда)

	ЛогинДляПроверки = СокрЛП(Логин);
	Если ПустаяСтрока(ЛогинДляПроверки) Или ПустаяСтрока(Пароль) Тогда
		Сообщить("Введите логин и пароль.");
		Возврат;
	КонецЕсли;

	// Сначала сохраняем введённое значение для проверки, затем очищаем поле
	ВведенныйПароль = Пароль;
	Пароль = "";
	Попытка
		ВходРазрешен = ВойтиНаСервере(ЛогинДляПроверки, ВведенныйПароль);
	Исключение
		ВведенныйПароль = "";
		Сообщить("Ошибка входа: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ВведенныйПароль = "";

	// Отказ в авторизации оставляет пользователя на форме входа
	Если Не ВходРазрешен Тогда
		Сообщить("Неверный логин или пароль.");
		Возврат;
	КонецЕсли;
	ОткрытьКаталог();

КонецПроцедуры

// Очищает пароль и запрашивает гостевой вход на сервере
&НаКлиенте
Процедура ПродолжитьКакГость(Команда)

	Пароль = "";
	Попытка
		ВойтиКакГостьНаСервере();
	Исключение
		Сообщить("Не удалось открыть гостевой доступ: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОткрытьКаталог();

КонецПроцедуры

// Разрешает служебное закрытие формы и возвращает навигационному модулю строку "ОткрытьКаталог"
&НаКлиенте
Процедура ОткрытьКаталог()

	РазрешеноЗакрытие = Истина;
	Закрыть("ОткрытьКаталог");

КонецПроцедуры

// Запрещает закрыть форму входа вручную и оставить приложение без рабочего экрана
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не ЗавершениеРаботы И РазрешеноЗакрытие <> Истина Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Передаёт логин и пароль общему серверному модулю и возвращает результат сравнения
&НаСервереБезКонтекста
Функция ВойтиНаСервере(ЛогинДляПроверки, ПарольДляПроверки)

	Возврат АвторизацияСервер.ВойтиПоПаролю(ЛогинДляПроверки, ПарольДляПроверки);

КонецФункции

// Устанавливает гостевой сеанс через общий модуль авторизации
&НаСервереБезКонтекста
Процедура ВойтиКакГостьНаСервере()

	АвторизацияСервер.ВойтиКакГость();

КонецПроцедуры