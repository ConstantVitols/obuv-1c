&НаКлиенте
Перем ФормаЗаказаОткрыта;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Попытка
		Доступ = ЗаказыСервер.ПроверитьПравоПросмотра();
	Исключение
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ФИОПользователя = Доступ.ФИО;
	Заголовок = "Заказы — " + Доступ.Роль;
	Элементы.ФИОПользователя.ТолькоПросмотр = Истина;
	Элементы.ФИОПользователя.Подсказка = "Учётная запись, под которой выполнен вход.";
	НастроитьКнопку("Назад", "Назад", Истина);
	НастроитьКнопку("ДобавитьЗаказ", "Добавить заказ", Доступ.МожетИзменятьДанные);
	АдресЗаказов = ЗаказыСервер.СформироватьHTMLЗаказов();

КонецПроцедуры

&НаСервере
Процедура НастроитьКнопку(ИмяКоманды, ЗаголовокКнопки, Показывать)

	КомандаФормы = Команды.Найти(ИмяКоманды);
	Если КомандаФормы = Неопределено Тогда
		КомандаФормы = Команды.Добавить(ИмяКоманды);
	КонецЕсли;
	КомандаФормы.Действие = ИмяКоманды;
	КомандаФормы.Заголовок = ЗаголовокКнопки;
	НайденнаяКнопка = Элементы.Найти(ИмяКоманды);
	Если НайденнаяКнопка <> Неопределено Тогда
		Если ТипЗнч(НайденнаяКнопка) <> Тип("КнопкаФормы") Тогда
			ВызватьИсключение "Имя элемента " + ИмяКоманды + " занято элементом другого типа. Проверьте дерево формы.";
		КонецЕсли;
	КонецЕсли;
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("КнопкаФормы") Тогда
			Если ЭлементФормы.ИмяКоманды = ИмяКоманды
				Или ЭлементФормы.ИмяКоманды = "Форма." + ИмяКоманды Тогда
				Если НайденнаяКнопка = Неопределено Тогда
					НайденнаяКнопка = ЭлементФормы;
				ИначеЕсли ЭлементФормы.Имя <> НайденнаяКнопка.Имя Тогда
					ЭлементФормы.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НайденнаяКнопка = Неопределено Тогда
		РодительКнопки = Элементы.Найти("Шапка");
		Если РодительКнопки = Неопределено Тогда
			РодительКнопки = ЭтотОбъект;
		КонецЕсли;
		НайденнаяКнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), РодительКнопки);
		НайденнаяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НайденнаяКнопка.ИмяКоманды = ИмяКоманды;
	КонецЕсли;
	НайденнаяКнопка.ИмяКоманды = ИмяКоманды;
	НайденнаяКнопка.Видимость = Показывать;
	НайденнаяКнопка.Шрифт = Новый Шрифт("Times New Roman", 12);
	Если ИмяКоманды = "ДобавитьЗаказ" Тогда
		НайденнаяКнопка.ЦветФона = Новый Цвет(0, 250, 154);
		НайденнаяКнопка.ЦветТекста = Новый Цвет(0, 0, 0);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаказ(Команда)

	ОткрытьКарточкуЗаказа(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ПолеЗаказовПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	АдресСсылки = Неопределено;
	Если Не ДанныеСобытия.Свойство("Href", АдресСсылки) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(АдресСсылки) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Префикс = "obuv-order:";
	Если Лев(АдресСсылки, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Попытка
		Идентификатор = Сред(АдресСсылки, СтрДлина(Префикс) + 1);
		СсылкаЗаказа = НайтиЗаказДляРедактированияНаСервере(Идентификатор);
		ОткрытьКарточкуЗаказа(СсылкаЗаказа);
	Исключение
		ПоказатьПредупреждение(Неопределено, "Не удалось открыть заказ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуЗаказа(СсылкаЗаказа)

	Если ФормаЗаказаОткрыта = Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПроверитьПравоИзмененияНаСервере();
		ПараметрыФормы = Новый Структура;
		Если СсылкаЗаказа <> Неопределено Тогда
			ПараметрыФормы.Вставить("Ключ", СсылкаЗаказа);
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗаказа", ЭтотОбъект);
		ФормаЗаказаОткрыта = Истина;
		ОткрытьФорму("Документ.Заказ.Форма.ФормаДокумента", ПараметрыФормы,
			ЭтотОбъект, Истина, , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ФормаЗаказаОткрыта = Ложь;
		ПоказатьПредупреждение(Неопределено, "Не удалось открыть редактор заказа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияЗаказа(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ФормаЗаказаОткрыта = Ложь;
	ОбновитьЗаказы();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЗаказыИзменены" Тогда
		ОбновитьЗаказы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаказы()

	Попытка
		АдресЗаказов = ПолучитьЗаказыНаСервере();
	Исключение
		ПоказатьПредупреждение(Неопределено, "Не удалось обновить заказы: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗаказыНаСервере()

	Возврат ЗаказыСервер.СформироватьHTMLЗаказов();

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьПравоИзмененияНаСервере()

	ЗаказыСервер.ПроверитьПравоИзменения();

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЗаказДляРедактированияНаСервере(Идентификатор)

	Возврат ЗаказыСервер.НайтиЗаказДляРедактирования(Идентификатор);

КонецФункции