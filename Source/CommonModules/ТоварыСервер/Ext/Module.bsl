Процедура ПроверитьПравоИзменения() Экспорт

	Доступ = АвторизацияСервер.ПолучитьТекущийДоступ();
	Если Не Доступ.ВходВыполнен Или Не Доступ.МожетИзменятьДанные Тогда
		ВызватьИсключение "Добавлять, изменять и удалять товары может только администратор.";
	КонецЕсли;

КонецПроцедуры

// Преобразует строковый UUID из ссылки витрины в ссылку справочника
Функция НайтиТоварДляРедактирования(Идентификатор) Экспорт

	ПроверитьПравоИзменения();
	Попытка
		ИдентификаторТовара = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		ВызватьИсключение "Не удалось определить выбранный товар.";
	КонецПопытки;
	Ссылка = Справочники.Товары.ПолучитьСсылку(ИдентификаторТовара);
	Товар = Ссылка.ПолучитьОбъект();
	Если Товар = Неопределено Тогда
		ВызватьИсключение "Товар уже удалён. Обновите каталог.";
	КонецЕсли;
	Если Товар.ПометкаУдаления Тогда
		ВызватьИсключение "Этот товар помечен на удаление.";
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// Проверяет обязательные поля, действительность ссылок, диапазоны чисел и уникальность артикула
// относительно других товаров
Процедура ПроверитьТоварДляЗаписи(Товар) Экспорт

	ПроверитьПравоИзменения();
	Товар.Наименование = СокрЛП(Товар.Наименование);
	Товар.Артикул = СокрЛП(Товар.Артикул);
	Если ПустаяСтрока(Товар.Наименование) Тогда
		ВызватьИсключение "Введите наименование товара.";
	КонецЕсли;
	Если ПустаяСтрока(Товар.Артикул) Тогда
		ВызватьИсключение "Введите артикул товара.";
	КонецЕсли;
	ПроверитьСсылку(Товар.Категория, "категорию");
	ПроверитьСсылку(Товар.Производитель, "производителя");
	ПроверитьСсылку(Товар.Поставщик, "поставщика");
	ПроверитьСсылку(Товар.ЕдиницаИзмерения, "единицу измерения");
	Если Товар.Цена < 0 Тогда
		ВызватьИсключение "Цена не может быть отрицательной.";
	КонецЕсли;
	Если Товар.КоличествоНаСкладе < 0
		Или Товар.КоличествоНаСкладе <> Цел(Товар.КоличествоНаСкладе) Тогда
		ВызватьИсключение "Количество на складе должно быть целым неотрицательным числом.";
	КонецЕсли;
	Если Товар.Скидка < 0 Или Товар.Скидка > 100 Тогда
		ВызватьИсключение "Действующая скидка должна быть от 0 до 100 процентов.";
	КонецЕсли;

	// Собственную ссылку исключаем из проверки уникальности: сохранение товара без изменения
	// артикула не должно считаться дублем
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Товары.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.Товары КАК Товары "
		+ "ГДЕ Товары.Артикул = &Артикул И Товары.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Артикул", Товар.Артикул);
	Запрос.УстановитьПараметр("Ссылка", Товар.Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Товар с таким артикулом уже существует. Укажите другой артикул.";
	КонецЕсли;

	// Неизменяемый ID сравниваем с сохранённой записью, а не только делаем поле формы недоступным
	Если Не Товар.ЭтоНовый() Тогда
		СохранённыйТовар = Товар.Ссылка.ПолучитьОбъект();
		Если СохранённыйТовар = Неопределено Тогда
			ВызватьИсключение "Редактируемый товар уже удалён.";
		КонецЕсли;
		Если Товар.Код <> СохранённыйТовар.Код Тогда
			ВызватьИсключение "ID существующего товара изменять нельзя.";
		КонецЕсли;
		Если Товар.ПометкаУдаления И ТоварЕстьВЗаказе(Товар.Ссылка) Тогда
			ВызватьИсключение "Товар присутствует в заказе. Его удаление запрещено.";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Назначает новому товару следующий числовой ID после максимального имеющегося кода
Процедура НазначитьКодНовомуТовару(Товар) Экспорт

	Если Не Товар.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(Товары.Код), 0) КАК ПоследнийКод "
		+ "ИЗ Справочник.Товары КАК Товары");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ПоследнийКод = Выборка.ПоследнийКод;
	Если ПоследнийКод >= 999999999 Тогда
		ВызватьИсключение "Закончился допустимый диапазон ID товаров.";
	КонецЕсли;
	Товар.Код = ПоследнийКод + 1;

КонецПроцедуры

// Возвращает Истина при наличии хотя бы одной строки заказа с указанным товаром
Функция ТоварЕстьВЗаказе(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 СтрокиЗаказа.Ссылка КАК Заказ "
		+ "ИЗ Документ.Заказ.Товары КАК СтрокиЗаказа "
		+ "ГДЕ СтрокиЗаказа.Товар = &Товар";
	Запрос.УстановитьПараметр("Товар", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Проверяет право администратора и отсутствие ссылок из заказов
Процедура ПроверитьВозможностьУдаления(Ссылка) Экспорт

	ПроверитьПравоИзменения();
	Если ТоварЕстьВЗаказе(Ссылка) Тогда
		ВызватьИсключение "Товар присутствует в заказе. Его удаление запрещено.";
	КонецЕсли;

КонецПроцедуры

// В транзакции повторно проверяет наличие товара и возможность удаления, затем физически удаляет запись
Процедура УдалитьТовар(Ссылка) Экспорт

	ПроверитьПравоИзменения();
	// Транзакция охватывает операции базы
	НачатьТранзакцию();
	Попытка
		Товар = Ссылка.ПолучитьОбъект();
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Товар уже удалён.";
		КонецЕсли;
		ПроверитьВозможностьУдаления(Ссылка);
		ПрежнийПуть = Товар.ПутьКИзображению;
		Товар.Удалить();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	УдалитьНеиспользуемоеФото(ПрежнийПуть);

КонецПроцедуры

// Проверяет право изменения, допустимое расширение, двоичные данные и фактические размеры читаемого изображения
Процедура ПроверитьВыбранноеФото(ДанныеФото, Расширение) Экспорт

	ПроверитьПравоИзменения();
	Если Расширение <> ".png" И Расширение <> ".jpg" И Расширение <> ".jpeg" Тогда
		ВызватьИсключение "Выберите фотографию в формате PNG или JPG.";
	КонецЕсли;
	Если ТипЗнч(ДанныеФото) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать выбранный файл фотографии.";
	КонецЕсли;
	Попытка
		// Проверяем читаемость и реальные ширину и высоту
		Фото = Новый Картинка(ДанныеФото);
		ШиринаФото = Фото.Ширина();
		ВысотаФото = Фото.Высота();
	Исключение
		ВызватьИсключение "Файл не является доступным для чтения изображением PNG или JPG.";
	КонецПопытки;
	Если ШиринаФото <= 0 Или ВысотаФото <= 0 Тогда
		ВызватьИсключение "Не удалось определить размеры фотографии.";
	КонецЕсли;
	Если ШиринаФото > 300 Или ВысотаФото > 200 Тогда
		ВызватьИсключение "Размер фотографии - " + Строка(ШиринаФото) + "×"
			+ Строка(ВысотаФото) + " пикселей. Допускается не более 300×200 пикселей. "
			+ "Уменьшите изображение и выберите его повторно.";
	КонецЕсли;

КонецПроцедуры

// Получает выбранный файл из временного хранилища, повторно проверяет его и сохраняет в Images под
// новым именем UUID с исходным расширением
Функция ЗаписатьНовоеФото(АдресДанных, Расширение) Экспорт

	ДанныеФото = ПолучитьИзВременногоХранилища(АдресДанных);
	ПроверитьВыбранноеФото(ДанныеФото, Расширение);
	КаталогБазы = ПолучитьКаталогБазы();
	СоздатьКаталог(КаталогБазы + "\Images");
	// UUID в имени - технический идентификатор файла, который предотвращает совпадения имён разных фотографий
	ОтносительныйПуть = "Images\" + Строка(Новый УникальныйИдентификатор()) + Расширение;
	ПолныйПуть = КаталогБазы + "\" + ОтносительныйПуть;
	Попытка
		ДанныеФото.Записать(ПолныйПуть);
	Исключение
		УдалитьНеиспользуемоеФото(ОтносительныйПуть);
		ВызватьИсключение "Не удалось сохранить фотографию в папку Images. " + ОписаниеОшибки();
	КонецПопытки;
	Возврат ОтносительныйПуть;

КонецФункции

// Возвращает путь именно из сохранённого объекта, а не из редактируемой формы
Функция ПолучитьПутьСохранённогоФото(Ссылка) Экспорт

	Если Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Товар = Ссылка.ПолучитьОбъект();
	Если Товар = Неопределено Тогда
		ВызватьИсключение "Товар уже удалён.";
	КонецЕсли;
	Возврат Товар.ПутьКИзображению;

КонецФункции

// Возвращает двоичные данные фотографии для предварительного просмотра
Функция ПолучитьДанныеФото(ОтносительныйПуть) Экспорт

	ПолныйПуть = ПолныйПутьФото(ОтносительныйПуть);
	Если Не ПустаяСтрока(ПолныйПуть) Тогда
		ФайлФото = Новый Файл(ПолныйПуть);
		Если ФайлФото.Существует() Тогда
			Если Не ФайлФото.ЭтоКаталог() Тогда
				Возврат Новый ДвоичныеДанные(ПолныйПуть);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ПутьЗаглушки = ПолучитьКаталогБазы() + "\Images\picture.png";
	Заглушка = Новый Файл(ПутьЗаглушки);
	Если Не Заглушка.Существует() Тогда
		ВызватьИсключение "В папке Images базы не найдена заглушка picture.png.";
	КонецЕсли;
	Возврат Новый ДвоичныеДанные(ПутьЗаглушки);

КонецФункции

// Проверяет новый непустой путь и файл перед записью товара
Процедура ПроверитьИзменениеПутиФото(Товар) Экспорт

	ПрежнийПуть = "";
	Если Не Товар.ЭтоНовый() Тогда
		ПрежнийПуть = ПолучитьПутьСохранённогоФото(Товар.Ссылка);
	КонецЕсли;
	// Пустой путь означает удаление фото
	Если ПустаяСтрока(Товар.ПутьКИзображению) Или Товар.ПутьКИзображению = ПрежнийПуть Тогда
		Возврат;
	КонецЕсли;
	ПолныйПуть = ПолныйПутьФото(Товар.ПутьКИзображению);
	Если ПустаяСтрока(ПолныйПуть) Тогда
		ВызватьИсключение "Фотография должна храниться в папке Images базы.";
	КонецЕсли;
	ФайлФото = Новый Файл(ПолныйПуть);
	Если Не ФайлФото.Существует() Тогда
		ВызватьИсключение "Файл новой фотографии не найден.";
	КонецЕсли;
	ПроверитьВыбранноеФото(Новый ДвоичныеДанные(ПолныйПуть), НРег(ФайлФото.Расширение));

КонецПроцедуры

// Удаляет внешний файл только если на его путь больше не ссылается ни один товар
Процедура УдалитьНеиспользуемоеФото(ОтносительныйПуть) Экспорт

	Если ПустаяСтрока(ОтносительныйПуть) Тогда
		Возврат;
	КонецЕсли;
	Если НРег(ОтносительныйПуть) = "images\picture.png" Тогда
		Возврат;
	КонецЕсли;
	ПолныйПуть = ПолныйПутьФото(ОтносительныйПуть);
	Если ПустаяСтрока(ПолныйПуть) Тогда
		Возврат;
	КонецЕсли;
	// Один файл может использоваться несколькими товарами. Наличие любой оставшейся ссылки запрещает его удаление
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Товары.Ссылка КАК Ссылка "
		+ "ИЗ Справочник.Товары КАК Товары ГДЕ Товары.ПутьКИзображению = &Путь");
	Запрос.УстановитьПараметр("Путь", ОтносительныйПуть);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ФайлФото = Новый Файл(ПолныйПуть);
		Если ФайлФото.Существует() Тогда
			Если Не ФайлФото.ЭтоКаталог() Тогда
				УдалитьФайлы(ПолныйПуть);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Данные сохранены, но прежний файл фотографии удалить не удалось: "
			+ ПолныйПуть + ". " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Для обязательного ссылочного поля проверяет заполнение, существование объекта и отсутствие пометки удаления
Процедура ПроверитьСсылку(Ссылка, НазваниеПоля)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Выберите " + НазваниеПоля + " из справочника.";
	КонецЕсли;
	ВыбранныйОбъект = Ссылка.ПолучитьОбъект();
	Если ВыбранныйОбъект = Неопределено Тогда
		ВызватьИсключение "Выбранный элемент для поля «" + НазваниеПоля + "» уже удалён.";
	КонецЕсли;
	Если ВыбранныйОбъект.ПометкаУдаления Тогда
		ВызватьИсключение "Выбранный элемент для поля «" + НазваниеПоля + "» помечен на удаление.";
	КонецЕсли;

КонецПроцедуры

// Допускает относительный путь вида Images\имя.png или JPG/JPEG без вложенных папок, переходов, диска и масок
Функция ПолныйПутьФото(ОтносительныйПуть)

	Путь = СтрЗаменить(СокрЛП(ОтносительныйПуть), "/", "\");
	Если НРег(Лев(Путь, 7)) <> "images\" Или СтрНайти(Путь, "..") > 0
		Или СтрНайти(Путь, ":") > 0 Или СтрНайти(Путь, "*") > 0
		Или СтрНайти(Путь, "?") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Имя = Сред(Путь, 8);
	Если ПустаяСтрока(Имя) Или СтрНайти(Имя, "\") > 0 Тогда
		Возврат "";
	КонецЕсли;
	ФайлФото = Новый Файл(Имя);
	Расширение = НРег(ФайлФото.Расширение);
	Если Расширение <> ".png" И Расширение <> ".jpg" И Расширение <> ".jpeg" Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПолучитьКаталогБазы() + "\" + Путь;

КонецФункции

// Получает каталог из параметра File строки соединения
Функция ПолучитьКаталогБазы()

	Соединение = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=""";
	Позиция = СтрНайти(Соединение, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "Работа с фотографиями настроена для файловой информационной базы.";
	КонецЕсли;
	Остаток = Сред(Соединение, Позиция + СтрДлина(Маркер));
	КонецПути = СтрНайти(Остаток, """");
	Если КонецПути = 0 Тогда
		ВызватьИсключение "Не удалось определить папку информационной базы.";
	КонецЕсли;
	Возврат Лев(Остаток, КонецПути - 1);

КонецФункции