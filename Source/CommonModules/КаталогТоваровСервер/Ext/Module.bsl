Функция СформироватьHTMLТоваров(ПоисковаяСтрока = "", ПоставщикОтбор = Неопределено,
	СортировкаОстатков = "Без сортировки") Экспорт

	Доступ = АвторизацияСервер.ПолучитьТекущийДоступ();
	Если Не Доступ.ВходВыполнен Тогда
		ВызватьИсключение "Для просмотра каталога сначала выполните вход.";
	КонецЕсли;

	Если ТипЗнч(ПоисковаяСтрока) <> Тип("Строка")
		Или ТипЗнч(СортировкаОстатков) <> Тип("Строка") Тогда
		ВызватьИсключение "Неверный тип параметров поиска.";
	КонецЕсли;
	Если СтрДлина(ПоисковаяСтрока) > 500 Тогда
		ВызватьИсключение "Поисковая строка должна содержать не более 500 символов.";
	КонецЕсли;
	Если ПоставщикОтбор = Неопределено Тогда
		ПоставщикОтбор = Справочники.Поставщики.ПустаяСсылка();
	КонецЕсли;
	Если ТипЗнч(ПоставщикОтбор) <> Тип("СправочникСсылка.Поставщики") Тогда
		ВызватьИсключение "Для отбора выберите поставщика из списка.";
	КонецЕсли;
	Если ПустаяСтрока(СортировкаОстатков) Тогда
		СортировкаОстатков = "Без сортировки";
	КонецЕсли;

	// Текст сортировки выбирается из фиксированных вариантов, а не подставляется из произвольного пользовательского ввода
	ПорядокЗапроса = "Товары.Код";
	Если СортировкаОстатков = "По возрастанию" Тогда
		ПорядокЗапроса = "Товары.КоличествоНаСкладе ВОЗР, Товары.Код";
	ИначеЕсли СортировкаОстатков = "По убыванию" Тогда
		ПорядокЗапроса = "Товары.КоличествоНаСкладе УБЫВ, Товары.Код";
	ИначеЕсли СортировкаОстатков <> "Без сортировки" Тогда
		ВызватьИсключение "Выбран неизвестный порядок сортировки.";
	КонецЕсли;

	// Права на фильтры проверяем на сервере даже при скрытой панели отбора в форме
	Если Не Доступ.МожетИскать Тогда
		Если Не ПустаяСтрока(ПоисковаяСтрока) Или Не ПоставщикОтбор.Пустая()
			Или СортировкаОстатков <> "Без сортировки" Тогда
			ВызватьИсключение "Поиск, отбор и сортировка доступны менеджеру и администратору.";
		КонецЕсли;
	КонецЕсли;
	СловаПоиска = СтрРазделить(НормализоватьПоиск(ПоисковаяСтрока), " ", Ложь);

	КаталогБазы = ПолучитьКаталогБазы();
	ПутьЗаглушки = КаталогБазы + "\Images\picture.png";
	Заглушка = ПрочитатьКартинкуКакDataURI(ПутьЗаглушки);
	Если ПустаяСтрока(Заглушка) Тогда
		ВызватьИсключение "Не найдена картинка-заглушка picture.png в папке Images базы.";
	КонецЕсли;
	КэшКартинок = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ "
		+ "Товары.Ссылка КАК Ссылка, "
		+ "Товары.Артикул КАК Артикул, "
		+ "Товары.Наименование КАК Наименование, "
		+ "Товары.Категория.Наименование КАК Категория, "
		+ "Товары.Описание КАК Описание, "
		+ "Товары.Производитель.Наименование КАК Производитель, "
		+ "Товары.Поставщик.Наименование КАК Поставщик, "
		+ "Товары.Поставщик КАК ПоставщикСсылка, "
		+ "Товары.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения, "
		+ "Товары.Цена КАК Цена, "
		+ "Товары.КоличествоНаСкладе КАК КоличествоНаСкладе, "
		+ "Товары.Скидка КАК Скидка, "
		+ "Товары.ПутьКИзображению КАК ПутьКИзображению "
		+ "ИЗ Справочник.Товары КАК Товары "
		+ "ГДЕ НЕ Товары.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО " + ПорядокЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();

	Карточки = "";
	ЧислоТоваров = 0;
	ВсегоТоваров = 0;
	Пока Выборка.Следующий() Цикл
		// Общее число считаем до применения фильтров
		ВсегоТоваров = ВсегоТоваров + 1;
		Если Не ПоставщикОтбор.Пустая()
			И Выборка.ПоставщикСсылка <> ПоставщикОтбор Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТоварСоответствуетПоиску(Выборка, СловаПоиска) Тогда
			Продолжить;
		КонецЕсли;
		АдресФото = ПолучитьФотоТовара(
			Выборка.ПутьКИзображению, КаталогБазы, Заглушка, КэшКартинок);
		Карточки = Карточки + КарточкаТовараHTML(Выборка, АдресФото, Доступ.МожетИзменятьДанные);
		ЧислоТоваров = ЧислоТоваров + 1;
	КонецЦикла;

	Разметка = "<!DOCTYPE html><html lang='ru'><head>"
		+ "<meta charset='utf-8'><meta http-equiv='X-UA-Compatible' content='IE=edge'>"
		+ "<style>"
		+ "html,body{margin:0;padding:0;background:#FFFFFF;color:#000000;"
		+ "font-family:'Times New Roman',serif;font-size:14pt;}"
		+ "body{padding:8px;}"
		+ ".count{margin:0 0 10px 0;font-size:12pt;}"
		+ ".card{width:100%;margin:0 0 12px 0;border:2px solid #000000;"
		+ "border-collapse:collapse;table-layout:fixed;}"
		+ ".card td{border:1px solid #000000;padding:10px;vertical-align:middle;"
		+ "word-wrap:break-word;}"
		+ ".card-link{display:block;color:#000000;text-decoration:none;cursor:pointer;}"
		+ ".card-link:hover .card{outline:2px solid #00FA9A;}"
		+ ".photo{width:22%;text-align:center;}"
		+ ".photo img{max-width:180px;max-height:160px;width:auto;height:auto;border:0;}"
		+ ".info{width:62%;}"
		+ ".discount{width:16%;text-align:center;}"
		+ ".name{font-weight:bold;margin-bottom:5px;}"
		+ ".line{margin:2px 0;}"
		+ ".old-price{color:#FF0000;text-decoration:line-through;margin-right:10px;}"
		+ ".new-price{color:#000000;}"
		+ ".discount-value{font-size:20pt;font-weight:bold;margin-top:8px;}"
		+ "</style></head><body>"
		+ "<div class='count'>Показано: " + Строка(ЧислоТоваров)
		+ " из " + Строка(ВсегоТоваров) + "</div>";
	Если ЧислоТоваров = 0 Тогда
		Если ВсегоТоваров = 0 Тогда
			Разметка = Разметка + "<p>В каталоге пока нет товаров.</p>";
		Иначе
			Разметка = Разметка + "<p>По заданным условиям товары не найдены.</p>";
		КонецЕсли;
	Иначе
		Разметка = Разметка + Карточки;
	КонецЕсли;
	Возврат Разметка + "</body></html>";

КонецФункции

// Приводит текст к нижнему регистру, заменяет «ё» на «е» и служебные пробельные символы на обычные пробелы
Функция НормализоватьПоиск(Значение)

	Текст = НРег(Строка(Значение));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Текст = СтрЗаменить(Текст, Символ(160), " ");
	Текст = СтрЗаменить(Текст, Символ(9), " ");
	Текст = СтрЗаменить(Текст, Символ(10), " ");
	Текст = СтрЗаменить(Текст, Символ(13), " ");
	Возврат СокрЛП(Текст);

КонецФункции

// Возвращает Истина, если каждое введённое слово встречается хотя бы в одном из объединённых
// текстовых реквизитов товара
Функция ТоварСоответствуетПоиску(Товар, СловаПоиска)

	Если СловаПоиска.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ТекстТовара = НормализоватьПоиск(Товар.Артикул + " " + Товар.Наименование
		+ " " + Товар.Категория + " " + Товар.Описание
		+ " " + Товар.Производитель + " " + Товар.Поставщик
		+ " " + Товар.ЕдиницаИзмерения + " " + Товар.ПутьКИзображению);
	Для Каждого Слово Из СловаПоиска Цикл
		Если СтрНайти(ТекстТовара, Слово) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Формирует карточку с фотографией, описанием, остатком и скидкой
Функция КарточкаТовараHTML(Товар, АдресФото, РазрешеноРедактирование)

	ЦветФона = "#FFFFFF";
	// Сначала проверяется отсутствие товара
	Если Товар.КоличествоНаСкладе = 0 Тогда
		ЦветФона = "#ADD8E6";
	ИначеЕсли Товар.Скидка > 15 Тогда
		ЦветФона = "#2E8B57";
	КонецЕсли;

	ЦенаHTML = ЭкранироватьHTML(Формат(Товар.Цена, "ЧДЦ=2;ЧГ=0;ЧН=0"));
	Если Товар.Скидка > 0 Тогда
		ЦенаСоСкидкой = Окр(Товар.Цена * (100 - Товар.Скидка) / 100, 2);
		ЦенаHTML = "<span class='old-price'>" + ЦенаHTML + "</span>"
			+ "<span class='new-price'>"
			+ ЭкранироватьHTML(Формат(ЦенаСоСкидкой, "ЧДЦ=2;ЧГ=0;ЧН=0")) + "</span>";
	КонецЕсли;

	ТочностьСкидки = 2;
	Если Товар.Скидка = Цел(Товар.Скидка) Тогда
		ТочностьСкидки = 0;
	КонецЕсли;
	ТекстСкидки = Формат(Товар.Скидка, "ЧДЦ=" + Строка(ТочностьСкидки) + ";ЧГ=0;ЧН=0");

	Разметка = "<table class='card' style='background-color:" + ЦветФона
		+ "' title='Артикул: " + ЭкранироватьHTML(Товар.Артикул) + "'><tr>"
		+ "<td class='photo'><img alt='Фото товара' src='" + АдресФото + "'></td>"
		+ "<td class='info'><div class='name'>"
		+ ЭкранироватьHTML(Товар.Категория) + " | "
		+ ЭкранироватьHTML(Товар.Наименование) + "</div>"
		+ "<div class='line'>Описание товара: " + ЭкранироватьHTML(Товар.Описание) + "</div>"
		+ "<div class='line'>Производитель: " + ЭкранироватьHTML(Товар.Производитель) + "</div>"
		+ "<div class='line'>Поставщик: " + ЭкранироватьHTML(Товар.Поставщик) + "</div>"
		+ "<div class='line'>Цена: " + ЦенаHTML + "</div>"
		+ "<div class='line'>Единица измерения: "
		+ ЭкранироватьHTML(Товар.ЕдиницаИзмерения) + "</div>"
		+ "<div class='line'>Количество на складе: "
		+ ЭкранироватьHTML(Формат(Товар.КоличествоНаСкладе, "ЧДЦ=0;ЧГ=0;ЧН=0")) + "</div></td>"
		+ "<td class='discount'>Действующая скидка"
		+ "<div class='discount-value'>"
		+ ЭкранироватьHTML(ТекстСкидки)
		+ "%</div></td></tr></table>";
	// Служебный адрес UUID перехватывает форма
	Если РазрешеноРедактирование Тогда
		АдресРедактирования = "obuv-product:" + Строка(Товар.Ссылка.УникальныйИдентификатор());
		Разметка = "<a class='card-link' href='" + АдресРедактирования + "'>"
			+ Разметка + "</a>";
	КонецЕсли;
	Возврат Разметка;

КонецФункции

// Заменяет специальные символы в данных HTML-сущностями, чтобы текст товара не превратился в разметку
Функция ЭкранироватьHTML(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, "'", "&#39;");
	Текст = СтрЗаменить(Текст, Символ(13), "");
	Возврат СтрЗаменить(Текст, Символ(10), "<br>");

КонецФункции

// Читает фотографию по относительному пути внутри Images и возвращает data URI либо заглушку
Функция ПолучитьФотоТовара(ОтносительныйПуть, КаталогБазы, Заглушка, КэшКартинок)

	Путь = СтрЗаменить(СокрЛП(Строка(ОтносительныйПуть)), "/", "\");
	Если ПустаяСтрока(Путь) Тогда
		Возврат Заглушка;
	КонецЕсли;
	Картинка = КэшКартинок.Получить(Путь);
	Если Картинка <> Неопределено Тогда
		Возврат Картинка;
	КонецЕсли;

	Картинка = "";
	Если НРег(Лев(Путь, 7)) = "images\" И СтрНайти(Путь, "..") = 0
		И СтрНайти(Путь, ":") = 0 Тогда
		Картинка = ПрочитатьКартинкуКакDataURI(КаталогБазы + "\" + Путь);
	КонецЕсли;
	Если ПустаяСтрока(Картинка) Тогда
		Картинка = Заглушка;
	КонецЕсли;
	КэшКартинок.Вставить(Путь, Картинка);
	Возврат Картинка;

КонецФункции

// Для существующего PNG/JPG/JPEG возвращает строку с MIME-типом и Base64-содержимым без переносов
Функция ПрочитатьКартинкуКакDataURI(ПутьФайла)

	ФайлКартинки = Новый Файл(ПутьФайла);
	Если Не ФайлКартинки.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Если ФайлКартинки.ЭтоКаталог() Тогда
		Возврат "";
	КонецЕсли;
	Расширение = НРег(ФайлКартинки.Расширение);
	Если Расширение = ".png" Тогда
		ТипКартинки = "image/png";
	ИначеЕсли Расширение = ".jpg" Или Расширение = ".jpeg" Тогда
		ТипКартинки = "image/jpeg";
	Иначе
		Возврат "";
	КонецЕсли;
	ДанныеФайла = Новый ДвоичныеДанные(ПутьФайла);
	КодКартинки = Base64Строка(ДанныеФайла);
	КодКартинки = СтрЗаменить(КодКартинки, Символ(13), "");
	КодКартинки = СтрЗаменить(КодКартинки, Символ(10), "");
	Возврат "data:" + ТипКартинки + ";base64," + КодКартинки;

КонецФункции

// Извлекает путь File из строки соединения файловой информационной базы
Функция ПолучитьКаталогБазы()

	Соединение = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=""";
	Позиция = СтрНайти(Соединение, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "Каталог настроен для файловой информационной базы.";
	КонецЕсли;
	Остаток = Сред(Соединение, Позиция + СтрДлина(Маркер));
	КонецПути = СтрНайти(Остаток, """");
	Если КонецПути = 0 Тогда
		ВызватьИсключение "Не удалось определить папку информационной базы.";
	КонецЕсли;
	Возврат Лев(Остаток, КонецПути - 1);

КонецФункции