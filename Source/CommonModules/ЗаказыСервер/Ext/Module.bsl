Функция ПроверитьПравоПросмотра() Экспорт

	Доступ = АвторизацияСервер.ПолучитьТекущийДоступ();
	Если Не Доступ.ВходВыполнен Или Не Доступ.МожетПросматриватьЗаказы Тогда
		ВызватьИсключение "Заказы доступны менеджеру и администратору. Выполните вход под соответствующей учётной записью.";
	КонецЕсли;
	Возврат Доступ;

КонецФункции

// После проверки просмотра дополнительно требует права администратора
Процедура ПроверитьПравоИзменения() Экспорт

	Доступ = ПроверитьПравоПросмотра();
	Если Не Доступ.МожетИзменятьДанные Тогда
		ВызватьИсключение "Добавлять, изменять и удалять заказы может только администратор. Менеджеру доступен просмотр списка.";
	КонецЕсли;

КонецПроцедуры

// Возвращает массив значений перечисления СтатусыЗаказов по его метаданным
Функция ПолучитьСтатусыЗаказов() Экспорт

	Статусы = Новый Массив;
	Для Каждого ОписаниеСтатуса Из Метаданные.Перечисления.СтатусыЗаказов.ЗначенияПеречисления Цикл
		Статусы.Добавить(Перечисления.СтатусыЗаказов[ОписаниеСтатуса.Имя]);
	КонецЦикла;
	Возврат Статусы;

КонецФункции

// Проверяет права и превращает UUID из служебной ссылки списка в ссылку документа
Функция НайтиЗаказДляРедактирования(Идентификатор) Экспорт

	ПроверитьПравоИзменения();
	Попытка
		ИдентификаторЗаказа = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		ВызватьИсключение "Не удалось определить выбранный заказ. Закройте список и откройте его повторно.";
	КонецПопытки;
	Ссылка = Документы.Заказ.ПолучитьСсылку(ИдентификаторЗаказа);
	Заказ = Ссылка.ПолучитьОбъект();
	Если Заказ = Неопределено Тогда
		ВызватьИсключение "Заказ уже удалён. Обновите список заказов.";
	КонецЕсли;
	Если Заказ.ПометкаУдаления Тогда
		ВызватьИсключение "Этот заказ помечен на удаление. Выберите другой заказ.";
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// Проверяет даты, статус, клиента, пункт выдачи, код получения и каждую позицию состава
Процедура ПроверитьЗаказДляЗаписи(Заказ) Экспорт

	ПроверитьПравоИзменения();
	Если Не ЗначениеЗаполнено(Заказ.Дата) Тогда
		ВызватьИсключение "Укажите дату заказа с помощью календаря.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Заказ.ДатаДоставки) Тогда
		ВызватьИсключение "Укажите дату доставки (выдачи) с помощью календаря.";
	КонецЕсли;
	// Сравниваем календарные дни: дата доставки без времени в тот же день допустима и при ненулевом времени оформления
	Если НачалоДня(Заказ.ДатаДоставки) < НачалоДня(Заказ.Дата) Тогда
		ВызватьИсключение "Дата доставки (выдачи) не может быть раньше даты заказа. Исправьте одну из дат.";
	КонецЕсли;
	Статусы = ПолучитьСтатусыЗаказов();
	Если Статусы.Найти(Заказ.Статус) = Неопределено Тогда
		ВызватьИсключение "Выберите статус заказа из выпадающего списка.";
	КонецЕсли;
	ПроверитьСсылку(Заказ.Клиент, "клиента");
	ПроверитьСсылку(Заказ.ПунктВыдачи, "пункт выдачи");
	Заказ.КодПолучения = СокрЛП(Заказ.КодПолучения);
	Если ПустаяСтрока(Заказ.КодПолучения) Тогда
		ВызватьИсключение "Введите код получения заказа, не более 20 символов.";
	КонецЕсли;
	Если Заказ.Товары.Количество() = 0 Тогда
		ВызватьИсключение "Добавьте хотя бы один товар в таблицу Состав заказа и укажите количество.";
	КонецЕсли;
	// Каждую позицию проверяем отдельно
	Для Каждого СтрокаЗаказа Из Заказ.Товары Цикл
		НомерСтроки = Строка(СтрокаЗаказа.НомерСтроки);
		Если Не ЗначениеЗаполнено(СтрокаЗаказа.Товар) Тогда
			ВызватьИсключение "В строке " + НомерСтроки + " выберите товар из списка.";
		КонецЕсли;
		Товар = СтрокаЗаказа.Товар.ПолучитьОбъект();
		Если Товар = Неопределено Тогда
			ВызватьИсключение "Товар в строке " + НомерСтроки + " уже удалён. Выберите другой товар.";
		КонецЕсли;
		Если Товар.ПометкаУдаления Тогда
			ВызватьИсключение "Товар в строке " + НомерСтроки + " помечен на удаление. Выберите другой товар.";
		КонецЕсли;
		Если СтрокаЗаказа.Количество <= 0
			Или СтрокаЗаказа.Количество <> Цел(СтрокаЗаказа.Количество) Тогда
			ВызватьИсключение "В строке " + НомерСтроки + " укажите целое количество больше нуля.";
		КонецЕсли;
	КонецЦикла;
	Если Не Заказ.ЭтоНовый() Тогда
		СохранённыйЗаказ = Заказ.Ссылка.ПолучитьОбъект();
		Если СохранённыйЗаказ = Неопределено Тогда
			ВызватьИсключение "Заказ уже удалён. Закройте редактор и обновите список.";
		КонецЕсли;
		Если Заказ.Номер <> СохранённыйЗаказ.Номер Тогда
			ВызватьИсключение "Номер существующего заказа изменять нельзя.";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Проверяет право администратора и ссылку, затем физически удаляет документ в транзакции вместе с его табличной частью
Процедура УдалитьЗаказ(Ссылка) Экспорт

	ПроверитьПравоИзменения();
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.Заказ") Тогда
		ВызватьИсключение "Не удалось определить заказ для удаления.";
	КонецЕсли;
	Если Ссылка.Пустая() Тогда
		ВызватьИсключение "Новый заказ ещё не записан. Для отмены добавления нажмите Назад.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Заказ = Ссылка.ПолучитьОбъект();
		Если Заказ = Неопределено Тогда
			ВызватьИсключение "Заказ уже удалён. Обновите список.";
		КонецЕсли;
		// Табличная часть принадлежит документу и удаляется платформой вместе с ним
		Заказ.Удалить();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает HTML-карточки действующих заказов после проверки права просмотра
Функция СформироватьHTMLЗаказов() Экспорт

	Доступ = ПроверитьПравоПросмотра();
	// Один общий запрос строк состава избавляет от отдельного запроса к базе для каждой карточки заказа
	СоставыЗаказов = Новый Соответствие;
	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст = "ВЫБРАТЬ СтрокиЗаказа.Ссылка КАК Заказ, "
		+ "СтрокиЗаказа.Товар.Артикул КАК Артикул, "
		+ "СтрокиЗаказа.Количество КАК Количество "
		+ "ИЗ Документ.Заказ.Товары КАК СтрокиЗаказа "
		+ "ГДЕ НЕ СтрокиЗаказа.Ссылка.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО СтрокиЗаказа.Ссылка, СтрокиЗаказа.НомерСтроки";
	ВыборкаСтрок = ЗапросСтрок.Выполнить().Выбрать();
	Пока ВыборкаСтрок.Следующий() Цикл
		Состав = СоставыЗаказов.Получить(ВыборкаСтрок.Заказ);
		Если Состав = Неопределено Тогда
			Состав = "";
		КонецЕсли;
		Если Не ПустаяСтрока(Состав) Тогда
			Состав = Состав + ", ";
		КонецЕсли;
		Состав = Состав + Строка(ВыборкаСтрок.Артикул) + " × "
			+ Формат(ВыборкаСтрок.Количество, "ЧДЦ=0;ЧГ=0;ЧН=0");
		СоставыЗаказов.Вставить(ВыборкаСтрок.Заказ, Состав);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Заказы.Ссылка КАК Ссылка, Заказы.Номер КАК Номер, "
		+ "Заказы.Дата КАК Дата, Заказы.Статус КАК Статус, "
		+ "Заказы.ПунктВыдачи.Наименование КАК АдресПунктаВыдачи, "
		+ "Заказы.ДатаДоставки КАК ДатаДоставки "
		+ "ИЗ Документ.Заказ КАК Заказы ГДЕ НЕ Заказы.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО Заказы.Номер";
	Выборка = Запрос.Выполнить().Выбрать();
	Карточки = "";
	КоличествоЗаказов = 0;
	Пока Выборка.Следующий() Цикл
		Состав = СоставыЗаказов.Получить(Выборка.Ссылка);
		Если Состав = Неопределено Тогда
			Состав = "Состав не указан";
		КонецЕсли;
		Карточка = "<table class='order'><tr><td class='details'>"
			+ "<div class='number'>Заказ №"
			+ ЭкранироватьHTML(Формат(Выборка.Номер, "ЧДЦ=0;ЧГ=0;ЧН=0")) + "</div>"
			+ "<div class='article'>Артикул заказа: " + ЭкранироватьHTML(Состав) + "</div>"
			+ "<div class='line'>Статус заказа: " + ЭкранироватьHTML(Выборка.Статус) + "</div>"
			+ "<div class='line'>Адрес пункта выдачи: "
			+ ЭкранироватьHTML(Выборка.АдресПунктаВыдачи) + "</div>"
			+ "<div class='line'>Дата заказа: "
			+ ЭкранироватьHTML(Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")) + "</div>"
			+ "</td><td class='delivery'>Дата доставки<div class='delivery-date'>"
			+ ЭкранироватьHTML(Формат(Выборка.ДатаДоставки, "ДФ=dd.MM.yyyy"))
			+ "</div></td></tr></table>";
		// Адрес obuv-order:UUID обрабатывает форма списка
		Если Доступ.МожетИзменятьДанные Тогда
			АдресРедактирования = "obuv-order:" + Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Карточка = "<a class='order-link' href='" + АдресРедактирования + "'>"
				+ Карточка + "</a>";
		КонецЕсли;
		Карточки = Карточки + Карточка;
		КоличествоЗаказов = КоличествоЗаказов + 1;
	КонецЦикла;
	Разметка = "<!DOCTYPE html><html lang='ru'><head><meta charset='utf-8'>"
		+ "<meta http-equiv='X-UA-Compatible' content='IE=edge'><style>"
		+ "html,body{margin:0;padding:0;background:#FFFFFF;color:#000000;"
		+ "font-family:'Times New Roman',serif;font-size:14pt;}"
		+ "body{padding:8px;}.count{margin-bottom:10px;font-size:12pt;}"
		+ ".order{width:100%;border-collapse:collapse;table-layout:fixed;"
		+ "border:2px solid #000000;margin-bottom:12px;}"
		+ ".order td{padding:12px;vertical-align:middle;word-wrap:break-word;}"
		+ ".details{width:76%;}.delivery{width:24%;border-left:1px solid #000000;"
		+ "text-align:center;}.delivery-date{margin-top:12px;font-weight:bold;}"
		+ ".article{font-weight:bold;margin-bottom:6px;}.number{font-size:12pt;margin-bottom:5px;}"
		+ ".line{margin:4px 0;}.order-link{display:block;color:#000000;text-decoration:none;}"
		+ ".order-link:hover .order{outline:2px solid #00FA9A;}"
		+ "</style></head><body><div class='count'>Заказов: "
		+ Строка(КоличествоЗаказов) + "</div>";
	Если КоличествоЗаказов = 0 Тогда
		Разметка = Разметка + "<p>В базе пока нет заказов.</p>";
	Иначе
		Разметка = Разметка + Карточки;
	КонецЕсли;
	Возврат Разметка + "</body></html>";

КонецФункции

// Проверяет заполнение ссылочного реквизита и наличие не помеченного на удаление объекта
Процедура ПроверитьСсылку(Ссылка, НазваниеПоля)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Выберите " + НазваниеПоля + " из выпадающего списка.";
	КонецЕсли;
	ВыбранныйОбъект = Ссылка.ПолучитьОбъект();
	Если ВыбранныйОбъект = Неопределено Тогда
		ВызватьИсключение "Выбранный элемент для поля «" + НазваниеПоля + "» удалён. Выберите другой.";
	КонецЕсли;
	Если ВыбранныйОбъект.ПометкаУдаления Тогда
		ВызватьИсключение "Выбранный элемент для поля «" + НазваниеПоля + "» помечен на удаление. Выберите другой.";
	КонецЕсли;

КонецПроцедуры

// Экранирует специальные символы данных заказа перед включением в HTML и сохраняет переносы через <br>
Функция ЭкранироватьHTML(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, "'", "&#39;");
	Текст = СтрЗаменить(Текст, Символ(13), "");
	Возврат СтрЗаменить(Текст, Символ(10), "<br>");

КонецФункции