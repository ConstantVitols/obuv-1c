Процедура ОткрытьВход() Экспорт

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВхода", ЭтотОбъект);
	ОткрытьФорму("Обработка.ВходВСистему.Форма.Форма",
		Неопределено, Неопределено, Истина, Неопределено, Неопределено,
		Оповещение, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Открывает каталог только при результате "ОткрытьКаталог". При ошибке открытия возвращает форму
// входа и показывает причину
Процедура ПослеЗакрытияВхода(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> "ОткрытьКаталог" Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОткрытьКаталог();
	Исключение
		ТекстОшибки = "Не удалось открыть каталог:" + Символы.ПС + ОписаниеОшибки();
		ОткрытьВход();
		ПоказатьПредупреждение(Неопределено, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Создаёт независимую витрину с обработчиком закрытия
Процедура ОткрытьКаталог()

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияКаталога", ЭтотОбъект);
	ОткрытьФорму("Обработка.ВитринаТоваров.Форма.Форма",
		Неопределено, Неопределено, Истина, Неопределено, Неопределено,
		Оповещение, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Возвращает форму авторизации после явного выхода с результатом "ОткрытьВход"
Процедура ПослеЗакрытияКаталога(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = "ОткрытьВход" Тогда
		ОткрытьВход();
	КонецЕсли;

КонецПроцедуры