Процедура СброситьВход() Экспорт

	ПараметрыСеанса.ТекущийПользователь = Справочники.Пользователи.ПустаяСсылка();
	ПараметрыСеанса.ВходВыполнен = Ложь;

КонецПроцедуры

// Возвращает Истина только после нахождения единственной действующей учётной записи и совпадения хеша
Функция ВойтиПоПаролю(ЛогинДляПроверки, ПарольДляПроверки) Экспорт

	СброситьВход();
	ЛогинДляПроверки = СокрЛП(ЛогинДляПроверки);
	Если ПустаяСтрока(ЛогинДляПроверки) Или ПустаяСтрока(ПарольДляПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 "
		+ "Пользователи.Ссылка КАК Ссылка, "
		+ "Пользователи.Роль КАК РольПользователя, "
		+ "Пользователи.ХешПароля КАК ХешПароля, "
		+ "Пользователи.СольПароля КАК СольПароля "
		+ "ИЗ Справочник.Пользователи КАК Пользователи "
		+ "ГДЕ Пользователи.Логин = &Логин "
		+ "И НЕ Пользователи.ПометкаУдаления";
	Запрос.УстановитьПараметр("Логин", ЛогинДляПроверки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	СсылкаПользователя = Выборка.Ссылка;
	РольПользователя = Выборка.РольПользователя;
	СохраненныйХеш = Выборка.ХешПароля;
	СольПользователя = Выборка.СольПароля;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Найдены несколько учётных записей с одинаковым логином.";
	КонецЕсли;
	Если Не ИзвестнаяРоль(РольПользователя) Тогда
		ВызватьИсключение "У учётной записи не указана допустимая роль.";
	КонецЕсли;

	ХешВведенногоПароля = РаботаСПаролями.СформироватьХешПароля(
		ПарольДляПроверки, СольПользователя);
	Если ХешВведенногоПароля <> СохраненныйХеш Тогда
		Возврат Ложь;
	КонецЕсли;

	// Состояние успешного входа устанавливаем только после всех проверок и сравнения хеша
	ПараметрыСеанса.ТекущийПользователь = СсылкаПользователя;
	ПараметрыСеанса.ВходВыполнен = Истина;
	Возврат Истина;

КонецФункции

// Создаёт гостевой сеанс без ссылки на пользователя
Процедура ВойтиКакГость() Экспорт

	СброситьВход();
	ПараметрыСеанса.ВходВыполнен = Истина;

КонецПроцедуры

// Возвращает структуру с ФИО, ролью и разрешениями для текущего сеанса
Функция ПолучитьТекущийДоступ() Экспорт

	Доступ = Новый Структура;
	Доступ.Вставить("ВходВыполнен", Ложь);
	Доступ.Вставить("ЭтоГость", Ложь);
	Доступ.Вставить("ФИО", "");
	Доступ.Вставить("Роль", "");
	Доступ.Вставить("МожетИскать", Ложь);
	Доступ.Вставить("МожетПросматриватьЗаказы", Ложь);
	Доступ.Вставить("МожетИзменятьДанные", Ложь);
	Если Не ПараметрыСеанса.ВходВыполнен Тогда
		Возврат Доступ;
	КонецЕсли;

	СсылкаПользователя = ПараметрыСеанса.ТекущийПользователь;
	// Гость - отдельное состояние сеанса, а не четвёртое значение перечисления РолиПользователей
	Если СсылкаПользователя.Пустая() Тогда
		Доступ.ВходВыполнен = Истина;
		Доступ.ЭтоГость = Истина;
		Доступ.ФИО = "Гость";
		Доступ.Роль = "Гость";
		Возврат Доступ;
	КонецЕсли;

	Пользователь = СсылкаПользователя.ПолучитьОбъект();
	Если Пользователь = Неопределено Тогда
		СброситьВход();
		Возврат Доступ;
	КонецЕсли;
	Если Пользователь.ПометкаУдаления Или Не ИзвестнаяРоль(Пользователь.Роль) Тогда
		СброситьВход();
		Возврат Доступ;
	КонецЕсли;

	РольПользователя = Пользователь.Роль;
	ЭтоАдминистратор = РольПользователя = Перечисления.РолиПользователей.Администратор;
	ЭтоМенеджер = РольПользователя = Перечисления.РолиПользователей.Менеджер;
	Доступ.ВходВыполнен = Истина;
	Доступ.ФИО = Пользователь.Наименование;
	Доступ.Роль = Строка(РольПользователя);
	Доступ.МожетИскать = ЭтоАдминистратор Или ЭтоМенеджер;
	Доступ.МожетПросматриватьЗаказы = ЭтоАдминистратор Или ЭтоМенеджер;
	Доступ.МожетИзменятьДанные = ЭтоАдминистратор;
	Возврат Доступ;

КонецФункции

// Проверяет принадлежность значения трём ролям прикладного перечисления
Функция ИзвестнаяРоль(РольПользователя)

	Возврат РольПользователя = Перечисления.РолиПользователей.Администратор
		Или РольПользователя = Перечисления.РолиПользователей.Менеджер
		Или РольПользователя = Перечисления.РолиПользователей.Клиент;

КонецФункции