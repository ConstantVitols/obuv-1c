Функция СоздатьСольПароля() Экспорт

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Вычисляет SHA-256 от строки "соль|пароль" в UTF-8 и возвращает шестнадцатеричную строку в нижнем регистре
Функция СформироватьХешПароля(Пароль, СольПароля) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	ДанныеПароля = ПолучитьДвоичныеДанныеИзСтроки(
		СольПароля + "|" + Пароль, КодировкаТекста.UTF8);
	Хеширование.Добавить(ДанныеПароля);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции