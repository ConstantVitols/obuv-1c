&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Попытка
		ТоварыСервер.ПроверитьПравоИзменения();
	Исключение
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	// Служебные реквизиты формы: флаг изменения, временный адрес нового файла, его расширение, подготовленный и прежний пути
	ФотоИзменено = Ложь;
	АдресНовогоФото = "";
	РасширениеНовогоФото = "";
	ПодготовленныйПутьФото = "";
	ПрежнийПутьФото = Объект.ПутьКИзображению;

	УстановитьПодсказкуПоля("Наименование", "Обязательное поле. Введите наименование товара до 150 символов.");
	УстановитьПодсказкуПоля("Артикул", "Введите уникальный артикул товара, не более 50 символов.");
	УстановитьПодсказкуПоля("Цена", "Цена неотрицательная, до двух знаков после запятой. Нулевая цена допустима.");
	УстановитьПодсказкуПоля("КоличествоНаСкладе", "Целое количество на складе. Ноль означает отсутствие товара.");
	УстановитьПодсказкуПоля("Скидка", "Действующая скидка: от 0 до 100 процентов.");
	УстановитьПодсказкуПоля("Категория", "Выберите категорию из справочника.");
	УстановитьПодсказкуПоля("Производитель", "Выберите производителя из справочника.");
	УстановитьПодсказкуПоля("Поставщик", "Выберите поставщика из справочника.");
	УстановитьПодсказкуПоля("ЕдиницаИзмерения", "Выберите единицу измерения из справочника.");

	ЗаполнитьСписокСправочника(Элементы.Категория, "КатегорииТоваров");
	ЗаполнитьСписокСправочника(Элементы.Производитель, "Производители");
	ЗаполнитьСписокСправочника(Элементы.Поставщик, "Поставщики");
	ЗаполнитьСписокСправочника(Элементы.ЕдиницаИзмерения, "ЕдиницыИзмерения");
	НастроитьКарточку(Объект.Ссылка, Объект.Наименование);
	ОбновитьФото();

КонецПроцедуры

// Заполняет поле ссылками и наименованиями действующих элементов одного из четырёх разрешённых справочников
&НаСервере
Процедура ЗаполнитьСписокСправочника(Поле, ИмяСправочника)

	Если ИмяСправочника <> "КатегорииТоваров" И ИмяСправочника <> "Производители"
		И ИмяСправочника <> "Поставщики" И ИмяСправочника <> "ЕдиницыИзмерения" Тогда
		ВызватьИсключение "Неизвестный справочник для поля карточки товара.";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ЭлементыСправочника.Ссылка КАК Ссылка, "
		+ "ЭлементыСправочника.Наименование КАК Наименование ИЗ Справочник."
		+ ИмяСправочника + " КАК ЭлементыСправочника ГДЕ НЕ ЭлементыСправочника.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО ЭлементыСправочника.Наименование");
	Поле.РежимВыбораИзСписка = Истина;
	Поле.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Поле.СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

КонецПроцедуры

// Для нового товара скрывает ID и удаление, для сохранённого показывает неизменяемый ID
&НаСервере
Процедура НастроитьКарточку(СсылкаТовара, НаименованиеТовара)

	НовыйТовар = СсылкаТовара.Пустая();
	Элементы.Код.Видимость = Не НовыйТовар;
	Элементы.Код.ТолькоПросмотр = Истина;
	Элементы.Код.Заголовок = "ID товара";
	Элементы.УдалитьТовар.Видимость = Не НовыйТовар;
	Если НовыйТовар Тогда
		Заголовок = "Добавление товара";
	Иначе
		Заголовок = "Редактирование товара: " + НаименованиеТовара;
	КонецЕсли;
	Элементы.Категория.КнопкаВыпадающегоСписка = Истина;
	Элементы.Производитель.КнопкаВыпадающегоСписка = Истина;
	Элементы.Поставщик.КнопкаВыпадающегоСписка = Истина;
	Элементы.ЕдиницаИзмерения.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

// Получает сохранённое фото или заглушку, помещает двоичные данные во временное хранилище формы и
// записывает адрес в реквизит предпросмотра
&НаСервере
Процедура ОбновитьФото()

	Попытка
		ДанныеФото = ТоварыСервер.ПолучитьДанныеФото(Объект.ПутьКИзображению);
		АдресФото = ПоместитьВоВременноеХранилище(ДанныеФото, УникальныйИдентификатор);
	Исключение
		АдресФото = "";
		Сообщить("Не удалось показать фотографию: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Запускает асинхронный выбор и помещение файла во временное хранилище, связанное с идентификатором формы
&НаКлиенте
Процедура ВыбратьФото(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФото", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

// При отмене диалога ничего не изменяет
&НаКлиенте
Процедура ПослеВыбораФото(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПринятьНовоеФотоНаСервере(Адрес, ВыбранноеИмяФайла);
		Модифицированность = Истина;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет права, расширение и содержимое выбранного файла
&НаСервере
Процедура ПринятьНовоеФотоНаСервере(Адрес, ИмяФайла)

	ТоварыСервер.ПроверитьПравоИзменения();
	ФайлФото = Новый Файл(ИмяФайла);
	Расширение = НРег(ФайлФото.Расширение);
	ДанныеФото = ПолучитьИзВременногоХранилища(Адрес);
	// Недопустимый выбор не должен заменить уже принятую фотографию: служебное состояние меняется только после проверки
	ТоварыСервер.ПроверитьВыбранноеФото(ДанныеФото, Расширение);
	ОчиститьПодготовленноеФото();
	АдресНовогоФото = Адрес;
	РасширениеНовогоФото = Расширение;
	АдресФото = Адрес;
	ФотоИзменено = Истина;

КонецПроцедуры

// Отмечает удаление фотографии на сервере и модифицированность формы
&НаКлиенте
Процедура УдалитьФото(Команда)

	УдалитьФотоНаСервере();
	Модифицированность = Истина;

КонецПроцедуры

// Очищает подготовленный новый файл, сбрасывает выбор фото и показывает заглушку
&НаСервере
Процедура УдалитьФотоНаСервере()

	ТоварыСервер.ПроверитьПравоИзменения();
	ОчиститьПодготовленноеФото();
	АдресНовогоФото = "";
	РасширениеНовогоФото = "";
	ФотоИзменено = Истина;
	ДанныеФото = ТоварыСервер.ПолучитьДанныеФото("");
	АдресФото = ПоместитьВоВременноеХранилище(ДанныеФото, УникальныйИдентификатор);

КонецПроцедуры

// Проверяет данные и запоминает прежний сохранённый путь
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Попытка
		ТоварыСервер.ПроверитьТоварДляЗаписи(ТекущийОбъект);
		ПрежнийПутьФото = ТоварыСервер.ПолучитьПутьСохранённогоФото(ТекущийОбъект.Ссылка);
		// Выбор фото сам по себе не меняет сохранённую запись
		Если ФотоИзменено Тогда
			ОчиститьПодготовленноеФото();
			Если ПустаяСтрока(АдресНовогоФото) Тогда
				ТекущийОбъект.ПутьКИзображению = "";
			Иначе
				ПодготовленныйПутьФото = ТоварыСервер.ЗаписатьНовоеФото(
					АдресНовогоФото, РасширениеНовогоФото);
				ТекущийОбъект.ПутьКИзображению = ПодготовленныйПутьФото;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Отказ = Истина;
		ОчиститьПодготовленноеФото();
		Сообщить("Товар не записан: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// После успешной записи удаляет прежнее фото, если оно больше не используется, и сбрасывает
// служебное состояние выбора
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Прежний файл очищается после успешной записи, чтобы отказ от сохранения не лишил товар фотографии.
	Если ПрежнийПутьФото <> ТекущийОбъект.ПутьКИзображению Тогда
		ТоварыСервер.УдалитьНеиспользуемоеФото(ПрежнийПутьФото);
	КонецЕсли;
	// Новый файл уже принадлежит сохранённому товару; он больше не считается временной подготовкой к записи.
	ПодготовленныйПутьФото = "";
	ПрежнийПутьФото = ТекущийОбъект.ПутьКИзображению;
	ФотоИзменено = Ложь;
	АдресНовогоФото = "";
	РасширениеНовогоФото = "";
	Объект.ПутьКИзображению = ТекущийОбъект.ПутьКИзображению;
	НастроитьКарточку(ТекущийОбъект.Ссылка, ТекущийОбъект.Наименование);
	ОбновитьФото();

КонецПроцедуры

// Сообщает открытой витрине о записи через оповещение «ТоварыИзменены»
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ТоварыИзменены", Объект.Ссылка, ЭтотОбъект);

КонецПроцедуры

// Закрывает карточку стандартным способом
&НаКлиенте
Процедура Назад(Команда)

	Закрыть();

КонецПроцедуры

// При закрытии просит убрать оставшийся подготовленный файл
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОчиститьПодготовленноеФото();

КонецПроцедуры

// Убирает файл, подготовленный для записи, если он остался неиспользуемым
&НаСервере
Процедура ОчиститьПодготовленноеФото()

	Если Не ПустаяСтрока(ПодготовленныйПутьФото) Тогда
		ТоварыСервер.УдалитьНеиспользуемоеФото(ПодготовленныйПутьФото);
		ПодготовленныйПутьФото = "";
	КонецЕсли;

КонецПроцедуры

// Запрашивает подтверждение необратимого удаления через асинхронный вопрос
&НаКлиенте
Процедура УдалитьТовар(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Удалить товар «" + Объект.Наименование
		+ "»? Это действие нельзя отменить.", РежимДиалогаВопрос.ДаНет,
		0, КодВозвратаДиалога.Нет);

КонецПроцедуры

// При согласии удаляет товар на сервере
&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьТоварНаСервере();
	Исключение
		Сообщить("Товар не удалён: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

// Не допускает удаление ещё не записанного товара
&НаСервере
Процедура УдалитьТоварНаСервере()

	Если Объект.Ссылка.Пустая() Тогда
		ВызватьИсключение "Новый товар ещё не записан. Для отмены добавления нажмите Назад.";
	КонецЕсли;
	ТоварыСервер.УдалитьТовар(Объект.Ссылка);
	ОчиститьПодготовленноеФото();

КонецПроцедуры

// Находит поле по пути Объект.<имя реквизита> и задаёт подсказку 
&НаСервере
Процедура УстановитьПодсказкуПоля(ИмяРеквизита, ТекстПодсказки)

	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			Если ЭлементФормы.ПутьКДанным = "Объект." + ИмяРеквизита Тогда
				ЭлементФормы.Подсказка = ТекстПодсказки;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры