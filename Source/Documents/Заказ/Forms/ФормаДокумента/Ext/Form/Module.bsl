&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Попытка
		ЗаказыСервер.ПроверитьПравоИзменения();
	Исключение
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Объект.Ссылка.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДата();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ДатаДоставки) Тогда
			Объект.ДатаДоставки = НачалоДня(Объект.Дата);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Статус) Тогда
			Объект.Статус = Перечисления.СтатусыЗаказов.Новый;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьСписки();
	НастроитьПоля();
	НастроитьКнопку("Назад", "Назад", Истина);
	НастроитьСостояние(Объект.Ссылка, Объект.Номер);

КонецПроцедуры

&НаСервере
Функция НайтиПоле(ПутьКДанным)

	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			Если ЭлементФормы.ПутьКДанным = ПутьКДанным Тогда
				Возврат ЭлементФормы;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "На форме заказа не найдено поле с ПутьКДанным = "
		+ ПутьКДанным + ". Добавьте соответствующее поле из реквизита Объект.";

КонецФункции

&НаСервере
Процедура ЗаполнитьСписки()

	ПолеСтатуса = НайтиПоле("Объект.Статус");
	ПолеСтатуса.РежимВыбораИзСписка = Истина;
	ПолеСтатуса.СписокВыбора.Очистить();
	Для Каждого СтатусЗаказа Из ЗаказыСервер.ПолучитьСтатусыЗаказов() Цикл
		ПолеСтатуса.СписокВыбора.Добавить(СтатусЗаказа, Строка(СтатусЗаказа));
	КонецЦикла;

	ПолеПункта = НайтиПоле("Объект.ПунктВыдачи");
	ПолеПункта.РежимВыбораИзСписка = Истина;
	ПолеПункта.СписокВыбора.Очистить();
	Запрос = Новый Запрос("ВЫБРАТЬ Пункты.Ссылка КАК Ссылка, "
		+ "Пункты.Наименование КАК Наименование ИЗ Справочник.ПунктыВыдачи КАК Пункты "
		+ "ГДЕ НЕ Пункты.ПометкаУдаления УПОРЯДОЧИТЬ ПО Пункты.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолеПункта.СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	ПолеКлиента = НайтиПоле("Объект.Клиент");
	ПолеКлиента.РежимВыбораИзСписка = Истина;
	ПолеКлиента.СписокВыбора.Очистить();
	Запрос = Новый Запрос("ВЫБРАТЬ Пользователи.Ссылка КАК Ссылка, "
		+ "Пользователи.Наименование КАК ФИО, Пользователи.Логин КАК Логин "
		+ "ИЗ Справочник.Пользователи КАК Пользователи "
		+ "ГДЕ НЕ Пользователи.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО Пользователи.Наименование, Пользователи.Логин");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолеКлиента.СписокВыбора.Добавить(
			Выборка.Ссылка, Выборка.ФИО + " (" + Выборка.Логин + ")");
	КонецЦикла;

	ПолеТовара = НайтиПоле("Объект.Товары.Товар");
	ПолеТовара.РежимВыбораИзСписка = Истина;
	ПолеТовара.СписокВыбора.Очистить();
	Запрос = Новый Запрос("ВЫБРАТЬ Товары.Ссылка КАК Ссылка, "
		+ "Товары.Артикул КАК Артикул, Товары.Наименование КАК Наименование "
		+ "ИЗ Справочник.Товары КАК Товары ГДЕ НЕ Товары.ПометкаУдаления "
		+ "УПОРЯДОЧИТЬ ПО Товары.Артикул");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолеТовара.СписокВыбора.Добавить(
			Выборка.Ссылка, Выборка.Артикул + " — " + Выборка.Наименование);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НастроитьПоля()

	ПолеНомера = НайтиПоле("Объект.Номер");
	ПолеНомера.ТолькоПросмотр = Истина;
	ПолеНомера.Подсказка = "Номер назначается автоматически при записи и затем не изменяется.";
	ПолеДаты = НайтиПоле("Объект.Дата");
	ПолеДаты.Формат = "ДФ=dd.MM.yyyy";
	ПолеДаты.ФорматРедактирования = "ДФ=dd.MM.yyyy";
	ПолеДаты.Подсказка = "Дата оформления заказа. Выберите её в календаре.";
	ПолеДоставки = НайтиПоле("Объект.ДатаДоставки");
	ПолеДоставки.Формат = "ДФ=dd.MM.yyyy";
	ПолеДоставки.ФорматРедактирования = "ДФ=dd.MM.yyyy";
	ПолеДоставки.Подсказка = "Дата доставки (выдачи) должна быть не раньше даты заказа.";
	ПолеСтатуса = НайтиПоле("Объект.Статус");
	ПолеСтатуса.Подсказка = "Выберите статус из перечисления СтатусыЗаказов.";
	ПолеКлиента = НайтиПоле("Объект.Клиент");
	ПолеКлиента.Подсказка = "Выберите покупателя. Учётные записи с одинаковыми ФИО различаются логинами.";
	ПолеПункта = НайтиПоле("Объект.ПунктВыдачи");
	ПолеПункта.Подсказка = "Выберите полный адрес пункта выдачи из справочника.";
	ПолеКода = НайтиПоле("Объект.КодПолучения");
	ПолеКода.Подсказка = "Введите код получения заказа, не более 20 символов.";
	ПолеТовара = НайтиПоле("Объект.Товары.Товар");
	ПолеТовара.Подсказка = "Выберите товар по артикулу и наименованию из списка товаров.";
	ПолеКоличества = НайтиПоле("Объект.Товары.Количество");
	ПолеКоличества.Подсказка = "Введите целое количество больше нуля.";

КонецПроцедуры

&НаСервере
Процедура НастроитьСостояние(СсылкаЗаказа, НомерЗаказа)

	НовыйЗаказ = СсылкаЗаказа.Пустая();
	ПолеНомера = НайтиПоле("Объект.Номер");
	ПолеНомера.Видимость = Не НовыйЗаказ;
	НастроитьКнопку("УдалитьЗаказ", "Удалить заказ", Не НовыйЗаказ);
	Если НовыйЗаказ Тогда
		Заголовок = "Добавление заказа";
	Иначе
		Заголовок = "Редактирование заказа №" + Формат(НомерЗаказа, "ЧДЦ=0;ЧГ=0;ЧН=0");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьКнопку(ИмяКоманды, ЗаголовокКнопки, Показывать)

	КомандаФормы = Команды.Найти(ИмяКоманды);
	Если КомандаФормы = Неопределено Тогда
		КомандаФормы = Команды.Добавить(ИмяКоманды);
	КонецЕсли;
	КомандаФормы.Действие = ИмяКоманды;
	КомандаФормы.Заголовок = ЗаголовокКнопки;
	НайденнаяКнопка = Элементы.Найти(ИмяКоманды);
	Если НайденнаяКнопка <> Неопределено Тогда
		Если ТипЗнч(НайденнаяКнопка) <> Тип("КнопкаФормы") Тогда
			ВызватьИсключение "Имя элемента " + ИмяКоманды + " занято элементом другого типа. Проверьте дерево формы.";
		КонецЕсли;
	КонецЕсли;
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("КнопкаФормы") Тогда
			Если ЭлементФормы.ИмяКоманды = ИмяКоманды
				Или ЭлементФормы.ИмяКоманды = "Форма." + ИмяКоманды Тогда
				Если НайденнаяКнопка = Неопределено Тогда
					НайденнаяКнопка = ЭлементФормы;
				ИначеЕсли ЭлементФормы.Имя <> НайденнаяКнопка.Имя Тогда
					ЭлементФормы.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НайденнаяКнопка = Неопределено Тогда
		НайденнаяКнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭтотОбъект);
		НайденнаяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НайденнаяКнопка.ИмяКоманды = ИмяКоманды;
	КонецЕсли;
	НайденнаяКнопка.ИмяКоманды = ИмяКоманды;
	НайденнаяКнопка.Видимость = Показывать;
	НайденнаяКнопка.Шрифт = Новый Шрифт("Times New Roman", 12);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Попытка
		ЗаказыСервер.ПроверитьЗаказДляЗаписи(ТекущийОбъект);
	Исключение
		Отказ = Истина;
		Сообщить("Заказ не записан: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	НастроитьСостояние(ТекущийОбъект.Ссылка, ТекущийОбъект.Номер);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ЗаказыИзменены", Объект.Ссылка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаказ(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Удалить заказ №"
		+ Формат(Объект.Номер, "ЧДЦ=0;ЧГ=0;ЧН=0")
		+ " вместе с его составом? Это действие нельзя отменить.",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьЗаказНаСервере();
	Исключение
		ПоказатьПредупреждение(Неопределено, "Заказ не удалён: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура УдалитьЗаказНаСервере()

	ЗаказыСервер.УдалитьЗаказ(Объект.Ссылка);

КонецПроцедуры